@model QuanLyNhaTro.Models.RentalContractFormViewModel

@{
    ViewData["Title"] = "Thêm hợp đồng thuê";
}

<h1>Thêm hợp đồng thuê</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="ContractCode" class="form-label">Mã hợp đồng</label>
        <input asp-for="ContractCode" class="form-control" />
        <span asp-validation-for="ContractCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RoomId" class="form-label">Phòng</label>
        <select asp-for="RoomId" class="form-select" id="RoomId">
            <option value="">-- Chọn phòng --</option>
            @foreach (QuanLyNhaTro.Models.RoomOptionViewModel roomOption in ViewBag.Rooms)
            {
                <option value="@roomOption.RoomId"
                        data-monthly-rent="@roomOption.MonthlyRent.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    @roomOption.DisplayName
                </option>
            }
        </select>
        <span asp-validation-for="RoomId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Người thuê trong hợp đồng</label>
        <div class="form-text mb-2">Chỉ hiển thị người đã thêm vào hợp đồng. Chọn một người làm đại diện; nhập quan hệ cho các người thuê còn lại.</div>

        @if (Model.TenantOptions.Count == 0)
        {
            <div class="alert alert-warning">
                Chưa có hồ sơ người thuê. Hãy <a asp-controller="Tenant" asp-action="Create">thêm người thuê</a> trước khi lập hợp đồng.
            </div>
        }
        else
        {
            <div id="selectedTenantList"
                 class="mb-3"
                 data-primary-tenant-id="@Model.PrimaryTenantId"></div>

            <button class="btn btn-outline-primary"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#tenantPicker"
                    aria-expanded="false"
                    aria-controls="tenantPicker">
                <span aria-hidden="true">+</span> Thêm người thuê
            </button>

            <div class="collapse mt-3" id="tenantPicker">
                <div class="card card-body">
                    <label for="tenantSearch" class="form-label">Tìm theo tên hoặc số điện thoại</label>
                    <input id="tenantSearch" type="search" class="form-control mb-3"
                           placeholder="Nhập tên hoặc số điện thoại..." />

                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Chọn</th>
                                    <th>Người thuê</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @for (var i = 0; i < Model.TenantOptions.Count; i++)
                            {
                                <tr class="tenant-picker-row"
                                    data-tenant-id="@Model.TenantOptions[i].TenantId"
                                    data-tenant-name="@Model.TenantOptions[i].FullName"
                                    data-tenant-phone="@Model.TenantOptions[i].Phone"
                                    data-relationship="@Model.TenantOptions[i].RelationshipToPrimaryTenant">
                                    <td class="text-center">
                                        <input type="hidden" asp-for="TenantOptions[i].TenantId" />
                                        <input asp-for="TenantOptions[i].IsSelected" class="form-check-input tenant-picker-checkbox" />
                                    </td>
                                    <td>
                                        <div>@Model.TenantOptions[i].FullName</div>
                                        <small class="text-muted">@Model.TenantOptions[i].Phone</small>
                                    </td>
                                    <td>
                                        <span asp-validation-for="TenantOptions[i].RelationshipToPrimaryTenant"
                                              class="text-danger tenant-relationship-validation"></span>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-secondary" type="button"
                                data-bs-toggle="collapse" data-bs-target="#tenantPicker">
                            Hoàn tất chọn
                        </button>
                    </div>
                </div>
            </div>
        }
        <span asp-validation-for="TenantOptions" class="text-danger"></span>
        <span asp-validation-for="PrimaryTenantId" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDate" class="form-label">Ngày kết thúc</label>
            <input asp-for="EndDate" type="date" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="MonthlyRent" class="form-label">Giá thuê thỏa thuận (đồng/tháng)</label>
            <input asp-for="MonthlyRent" type="number" min="0.01" step="0.01" required class="form-control" />
            <span asp-validation-for="MonthlyRent" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Deposit" class="form-label">Tiền đặt cọc</label>
            <input asp-for="Deposit" type="number" min="0" step="0.01" class="form-control" />
            <span asp-validation-for="Deposit" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Terms" class="form-label">Điều khoản</label>
        <textarea asp-for="Terms" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Terms" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_TenantRelationshipScripts" />
}
