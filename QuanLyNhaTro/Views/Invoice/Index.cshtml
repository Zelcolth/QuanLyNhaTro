@model QuanLyNhaTro.ViewModels.InvoiceIndexViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Quản lý hóa đơn";
    var billingPeriod = DateTime.ParseExact(Model.BillingMonth, "yyyy-MM", CultureInfo.InvariantCulture);
    var previousMonth = billingPeriod.AddMonths(-1);
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="mb-1">Hóa đơn tháng @Model.BillingMonthLabel</h1>
        <div class="text-muted">Quản lý và theo dõi thu tiền theo kỳ</div>
    </div>

    <div class="d-flex flex-column align-items-start align-items-xl-end gap-2">
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-primary" disabled title="Chức năng sẽ được bổ sung sau">In PDF</button>
            <button type="button" class="btn btn-secondary" disabled title="Chức năng sẽ được bổ sung sau">Xuất ảnh hóa đơn</button>
            <button type="button" class="btn btn-success" disabled title="Chức năng sẽ được bổ sung sau">Xuất Excel</button>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="UtilityReading" asp-action="Index" asp-route-readingMonth="@Model.BillingMonth"
               class="btn btn-outline-secondary">Nhập chỉ số điện nước</a>
            <form asp-action="GenerateMonth" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="billingMonth" value="@Model.BillingMonth" />
                <button type="submit" class="btn btn-primary">Lập hóa đơn</button>
            </form>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["GenerationWarnings"] is string warnings)
{
    <div class="alert alert-warning" role="alert">
        <strong>Cần kiểm tra một số phòng:</strong> @warnings
    </div>
}

<div id="paymentFeedback" class="alert d-none" role="status" aria-live="polite"></div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label for="billingMonth" class="form-label">Kỳ hóa đơn</label>
                <input id="billingMonth" name="billingMonth" type="month" value="@Model.BillingMonth"
                       max="@Model.CurrentMonth" class="form-control" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Xem kỳ</button>
            </div>
        </form>
    </div>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted mb-1">Phòng chưa thu</div>
                <div class="fs-4 fw-semibold" id="unpaidCount">@Model.UnpaidCount</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted mb-1">Phòng đã thu</div>
                <div class="fs-4 fw-semibold" id="paidCount">@Model.PaidCount</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted mb-1">Tổng tiền đã thu</div>
                <div class="fs-4 fw-semibold text-nowrap" id="collectedAmount">@Model.CollectedAmount.ToString("N0") đ</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted mb-1">Tổng tiền chưa thu</div>
                <div class="fs-4 fw-semibold text-nowrap" id="outstandingAmount">@Model.OutstandingAmount.ToString("N0") đ</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted mb-1">Tổng tiền điện</div>
                <div class="fs-4 fw-semibold text-nowrap" id="electricityTotal">@Model.ElectricityTotal.ToString("N0") đ</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted mb-1">Tổng tiền nước</div>
                <div class="fs-4 fw-semibold text-nowrap" id="waterTotal">@Model.WaterTotal.ToString("N0") đ</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted mb-1">Tổng doanh thu tháng</div>
                <div class="fs-4 fw-semibold text-nowrap" id="revenueTotal">@Model.RevenueTotal.ToString("N0") đ</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-4 col-lg-3">
        <label for="roomFilter" class="form-label">Lọc theo phòng</label>
        <select id="roomFilter" class="form-select">
            <option value="">Tất cả phòng</option>
            @foreach (var room in Model.RoomOptions)
            {
                <option value="@room">@room</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-8 col-lg-9 text-muted">
        Có thể điều chỉnh tiền phòng, tiền rác, nợ tháng trước và tiền giảm cho hóa đơn chưa thu. Nợ tháng trước được đối chiếu và nhập thủ công.
    </div>
</div>

@if (Model.Invoices.Count == 0)
{
    <div class="alert alert-info">
        Chưa có hóa đơn kỳ @billingPeriod.ToString("MM/yyyy"). Nhập đủ chỉ số điện nước rồi chọn “Lập hóa đơn”.
    </div>
}
else
{
    <table class="table table-bordered table-striped table-hover align-middle w-100">
            <thead class="table-light text-center">
                <tr>
                    <th scope="col" aria-sort="none"><button type="button" class="btn btn-link p-0 fw-semibold text-decoration-none text-dark sort-button" data-sort="room">Mã phòng <span data-sort-indicator aria-hidden="true">↕</span></button></th>
                    <th scope="col" aria-sort="none"><button type="button" class="btn btn-link p-0 fw-semibold text-decoration-none text-dark sort-button" data-sort="status">Trạng thái thu <span data-sort-indicator aria-hidden="true">↕</span></button></th>
                    <th>Tên khách thuê</th>
                    <th>Tiền phòng</th>
                    <th>Điện cũ<br />@previousMonth.ToString("MM/yyyy")</th>
                    <th>Điện mới<br />@billingPeriod.ToString("MM/yyyy")</th>
                    <th>Số điện dùng</th>
                    <th>Nước cũ<br />@previousMonth.ToString("MM/yyyy")</th>
                    <th>Nước mới<br />@billingPeriod.ToString("MM/yyyy")</th>
                    <th>Số nước dùng</th>
                    <th>Tiền rác</th>
                    <th>Internet</th>
                    <th>Nợ tháng trước</th>
                    <th>Tiền giảm</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái HĐ</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var invoice in Model.Invoices)
            {
                var amountFormId = $"amount-form-{invoice.InvoiceId}";

                <tr data-invoice-row
                    data-room-key="@invoice.RoomLabel"
                    data-paid="@(invoice.IsPaid ? "true" : "false")"
                    data-total="@invoice.TotalAmount.ToString(CultureInfo.InvariantCulture)"
                    data-saved-total="@invoice.TotalAmount.ToString(CultureInfo.InvariantCulture)"
                    data-electricity="@invoice.ElectricityAmount.ToString(CultureInfo.InvariantCulture)"
                    data-water="@invoice.WaterAmount.ToString(CultureInfo.InvariantCulture)"
                    data-wifi="@invoice.WifiFee.ToString(CultureInfo.InvariantCulture)">
                    <td>
                        <form id="@amountFormId" asp-action="UpdateAmounts" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@invoice.InvoiceId" />
                            <input type="hidden" name="billingMonth" value="@Model.BillingMonth" />
                        </form>
                        <div class="fw-semibold text-nowrap">@invoice.RoomLabel</div>
                        <div class="text-muted small">@invoice.InvoiceCode</div>
                    </td>
                    <td class="text-nowrap">
                        <form asp-action="UpdatePaymentStatus" method="post" class="payment-status-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@invoice.InvoiceId" />
                            <div class="form-check">
                                <input class="form-check-input payment-status-checkbox" type="checkbox"
                                       name="isPaid" value="true" checked="@invoice.IsPaid"
                                       aria-label="Đánh dấu đã thu hóa đơn @invoice.InvoiceCode" />
                                <label class="form-check-label payment-status-label">@(invoice.IsPaid ? "Đã thu" : "Chưa thu")</label>
                            </div>
                        </form>
                    </td>
                    <td>@invoice.TenantName</td>
                    <td>
                        <input form="@amountFormId" name="rentAmount" type="number"
                               class="form-control amount-input" min="0" step="1000"
                               value="@invoice.RentAmount.ToString(CultureInfo.InvariantCulture)"
                               aria-label="Tiền phòng" required disabled="@(invoice.IsPaid ? "disabled" : null)" />
                    </td>
                    <td class="text-end text-nowrap">@invoice.PreviousElectricityReading.ToString("N2")</td>
                    <td class="text-end text-nowrap">@invoice.CurrentElectricityReading.ToString("N2")</td>
                    <td class="text-end text-nowrap" title="Đơn giá: @invoice.ElectricityUnitPrice.ToString("N0") đ/kWh">@invoice.ElectricityConsumption.ToString("N2")</td>
                    <td class="text-end text-nowrap">@invoice.PreviousWaterReading.ToString("N2")</td>
                    <td class="text-end text-nowrap">@invoice.CurrentWaterReading.ToString("N2")</td>
                    <td class="text-end text-nowrap" title="Đơn giá: @invoice.WaterUnitPrice.ToString("N0") đ/m³">@invoice.WaterConsumption.ToString("N2")</td>
                    <td>
                        <input form="@amountFormId" name="garbageFee" type="number"
                               class="form-control amount-input" min="0" step="1000"
                               value="@invoice.GarbageFee.ToString(CultureInfo.InvariantCulture)"
                               aria-label="Tiền rác" required disabled="@(invoice.IsPaid ? "disabled" : null)" />
                    </td>
                    <td class="text-end text-nowrap">@invoice.WifiFee.ToString("N0") đ</td>
                    <td>
                        <input form="@amountFormId" name="previousDebtAmount" type="number"
                               class="form-control amount-input" min="0" step="1000"
                               value="@invoice.PreviousDebtAmount.ToString(CultureInfo.InvariantCulture)"
                               aria-label="Nợ tháng trước" required disabled="@(invoice.IsPaid ? "disabled" : null)" />
                    </td>
                    <td>
                        <input form="@amountFormId" name="discountAmount" type="number"
                               class="form-control amount-input" min="0" step="1000"
                               value="@invoice.DiscountAmount.ToString(CultureInfo.InvariantCulture)"
                               aria-label="Tiền giảm trừ" required disabled="@(invoice.IsPaid ? "disabled" : null)" />
                    </td>
                    <td class="text-end fw-semibold text-nowrap invoice-total-cell">@invoice.TotalAmount.ToString("N0") đ</td>
                    <td class="text-nowrap">@invoice.ContractStatusLabel</td>
                    <td>
                        <div class="d-flex flex-column gap-2">
                            <a asp-action="Details" asp-route-id="@invoice.InvoiceId"
                               class="btn btn-sm btn-primary text-nowrap">Chi tiết/In HĐ</a>
                            @if (invoice.ContractStatus == "Active")
                            {
                                <a asp-controller="RentalContract" asp-action="Details" asp-route-id="@invoice.ContractId"
                                   class="btn btn-sm btn-danger text-nowrap">Trả phòng</a>
                            }
                            else
                            {
                                <a asp-controller="RentalContract" asp-action="Details" asp-route-id="@invoice.ContractId"
                                   class="btn btn-sm btn-outline-danger text-nowrap">Hợp đồng</a>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
}

@section Scripts {
    <script>
        (() => {
            const roomFilter = document.getElementById("roomFilter");
            const rows = Array.from(document.querySelectorAll("[data-invoice-row]"));
            const feedback = document.getElementById("paymentFeedback");
            const moneyFormatter = new Intl.NumberFormat("vi-VN", { maximumFractionDigits: 0 });
            const formatMoney = value => moneyFormatter.format(Number(value) || 0) + " đ";
            const amountNames = ["rentAmount", "garbageFee", "previousDebtAmount", "discountAmount"];
            const saveTimers = new WeakMap();
            const saveInProgress = new WeakMap();

            function showFeedback(message, success) {
                feedback.className = "alert " + (success ? "alert-success" : "alert-danger");
                feedback.textContent = message;
            }

            function getAmount(row, name) {
                const input = row.querySelector(`.amount-input[name="${name}"]`);
                const value = Number(input?.value ?? 0);
                return Number.isFinite(value) ? value : 0;
            }

            function calculateRowTotal(row) {
                return getAmount(row, "rentAmount")
                    + Number(row.dataset.electricity || 0)
                    + Number(row.dataset.water || 0)
                    + getAmount(row, "garbageFee")
                    + Number(row.dataset.wifi || 0)
                    + getAmount(row, "previousDebtAmount")
                    - getAmount(row, "discountAmount");
            }

            function updateSummary() {
                const paidRows = rows.filter(row => row.dataset.paid === "true");
                const unpaidRows = rows.filter(row => row.dataset.paid !== "true");
                const sum = (items, key) => items.reduce((total, row) => total + Number(row.dataset[key] || 0), 0);

                document.getElementById("paidCount").textContent = paidRows.length;
                document.getElementById("unpaidCount").textContent = unpaidRows.length;
                document.getElementById("collectedAmount").textContent = formatMoney(sum(paidRows, "total"));
                document.getElementById("outstandingAmount").textContent = formatMoney(sum(unpaidRows, "total"));
                document.getElementById("electricityTotal").textContent = formatMoney(sum(rows, "electricity"));
                document.getElementById("waterTotal").textContent = formatMoney(sum(rows, "water"));
                document.getElementById("revenueTotal").textContent = formatMoney(sum(rows, "total"));
            }

            function updateRowTotal(row) {
                const total = calculateRowTotal(row);
                row.dataset.total = String(total);
                const totalCell = row.querySelector(".invoice-total-cell");
                if (totalCell) totalCell.textContent = formatMoney(total);
                updateSummary();
            }

            function restoreSavedAmounts(row) {
                row.querySelectorAll(".amount-input").forEach(input => {
                    if (input.dataset.savedValue !== undefined) {
                        input.value = input.dataset.savedValue;
                    }
                });
                row.dataset.total = row.dataset.savedTotal || row.dataset.total;
                const totalCell = row.querySelector(".invoice-total-cell");
                if (totalCell) totalCell.textContent = formatMoney(row.dataset.total);
                updateSummary();
            }

            async function saveRowAmounts(row) {
                const currentSave = saveInProgress.get(row);
                if (currentSave) return currentSave;

                const form = row.querySelector("form[id^='amount-form-']");
                const inputs = Array.from(row.querySelectorAll(".amount-input"));
                if (!form || inputs.length !== amountNames.length) return false;

                if (inputs.some(input => input.value.trim() === "" || !Number.isFinite(Number(input.value)) || Number(input.value) < 0)) {
                    showFeedback("Vui lòng nhập đầy đủ các khoản tiền không âm. Thay đổi chưa được lưu.", false);
                    return false;
                }

                const formData = new FormData(form);
                amountNames.forEach(name => {
                    const input = row.querySelector(`.amount-input[name="${name}"]`);
                    formData.set(name, input.value);
                });
                const submittedValues = Object.fromEntries(amountNames.map(name => {
                    const input = row.querySelector(`.amount-input[name="${name}"]`);
                    return [name, input.value];
                }));

                inputs.forEach(input => input.disabled = true);

                const request = (async () => {
                    try {
                        const response = await fetch(form.action, {
                            method: "POST",
                            body: formData,
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });

                        let result;
                        try {
                            result = await response.json();
                        } catch {
                            throw new Error("Máy chủ không trả về phản hồi hợp lệ. Vui lòng thử lại.");
                        }

                        if (!response.ok || result.success !== true) {
                            throw new Error(result.message || "Không thể tự động lưu các khoản tiền.");
                        }

                        row.dataset.total = String(Number(result.totalAmount));
                        row.dataset.savedTotal = row.dataset.total;
                        amountNames.forEach(name => {
                            const input = row.querySelector(`.amount-input[name="${name}"]`);
                            input.dataset.savedValue = submittedValues[name];
                        });

                        const totalCell = row.querySelector(".invoice-total-cell");
                        if (totalCell) totalCell.textContent = formatMoney(result.totalAmount);
                        updateSummary();
                        showFeedback(result.message || "Đã tự động lưu các khoản tiền.", true);
                        return true;
                    } catch (error) {
                        restoreSavedAmounts(row);
                        showFeedback(error.message || "Không thể tự động lưu các khoản tiền.", false);
                        return false;
                    } finally {
                        inputs.forEach(input => {
                            input.disabled = row.dataset.paid === "true";
                        });
                        saveInProgress.delete(row);
                    }
                })();

                saveInProgress.set(row, request);
                return request;
            }

            function scheduleAmountSave(row) {
                const oldTimer = saveTimers.get(row);
                if (oldTimer) clearTimeout(oldTimer);

                const timer = setTimeout(async () => {
                    saveTimers.delete(row);
                    await saveRowAmounts(row);
                }, 600);
                saveTimers.set(row, timer);
            }

            rows.forEach(row => {
                row.querySelectorAll(".amount-input").forEach(input => {
                    input.dataset.savedValue = input.value;
                    input.addEventListener("input", () => {
                        updateRowTotal(row);
                        scheduleAmountSave(row);
                    });
                    input.addEventListener("change", () => {
                        updateRowTotal(row);
                        scheduleAmountSave(row);
                    });
                });
            });

            if (roomFilter) {
                roomFilter.addEventListener("change", () => {
                    const selectedRoom = roomFilter.value;
                    rows.forEach(row => {
                        row.hidden = selectedRoom !== "" && row.dataset.roomKey !== selectedRoom;
                    });
                });
            }

            // Click the room or payment-status heading to sort ascending/descending.
            let activeSort = { key: null, direction: "asc" };

            function getRoomCode(row) {
                const label = row.dataset.roomKey || "";
                const match = label.match(/phòng\\s+(.+)$/i);
                return match ? match[1].trim() : label;
            }

            function sortInvoiceRows(key, direction) {
                const multiplier = direction === "asc" ? 1 : -1;
                const tbody = document.querySelector("table tbody");
                if (!tbody) return;

                const sortedRows = [...rows].sort((a, b) => {
                    if (key === "status") {
                        const aPaid = a.dataset.paid === "true" ? 1 : 0;
                        const bPaid = b.dataset.paid === "true" ? 1 : 0;
                        return (aPaid - bPaid) * multiplier;
                    }

                    const aCode = getRoomCode(a);
                    const bCode = getRoomCode(b);
                    const codeComparison = aCode.localeCompare(bCode, "vi", {
                        numeric: true,
                        sensitivity: "base"
                    });
                    if (codeComparison !== 0) return codeComparison * multiplier;

                    return (a.dataset.roomKey || "").localeCompare(
                        b.dataset.roomKey || "", "vi", { sensitivity: "base" }
                    ) * multiplier;
                });

                sortedRows.forEach(row => tbody.appendChild(row));

                document.querySelectorAll(".sort-button").forEach(button => {
                    const isActive = button.dataset.sort === key;
                    const indicator = button.querySelector("[data-sort-indicator]");
                    if (indicator) {
                        indicator.textContent = isActive
                            ? (direction === "asc" ? "↑" : "↓")
                            : "↕";
                    }

                    const heading = button.closest("th");
                    if (heading) {
                        heading.setAttribute(
                            "aria-sort",
                            isActive ? (direction === "asc" ? "ascending" : "descending") : "none"
                        );
                    }
                });
            }

            document.querySelectorAll(".sort-button").forEach(button => {
                button.addEventListener("click", () => {
                    const key = button.dataset.sort;
                    const direction = activeSort.key === key && activeSort.direction === "asc"
                        ? "desc"
                        : "asc";
                    activeSort = { key, direction };
                    sortInvoiceRows(key, direction);
                });
            });

            document.querySelectorAll(".payment-status-form").forEach(form => {
                const checkbox = form.querySelector(".payment-status-checkbox");
                const label = form.querySelector(".payment-status-label");
                if (!checkbox) return;

                checkbox.addEventListener("change", async () => {
                    const previousValue = !checkbox.checked;
                    const row = form.closest("[data-invoice-row]");
                    const pendingTimer = row && saveTimers.get(row);

                    // Save any pending amount edit before changing the invoice to Paid.
                    if (pendingTimer) {
                        clearTimeout(pendingTimer);
                        saveTimers.delete(row);
                        const saved = await saveRowAmounts(row);
                        if (!saved) {
                            checkbox.checked = previousValue;
                            return;
                        }
                    }

                    const activeSave = row && saveInProgress.get(row);
                    if (activeSave) {
                        const saved = await activeSave;
                        if (!saved) {
                            checkbox.checked = previousValue;
                            return;
                        }
                    }

                    // Set isPaid explicitly, because disabled controls are excluded from FormData
                    // and unchecked checkboxes are omitted by the browser.
                    const formData = new FormData(form);
                    formData.set("isPaid", checkbox.checked ? "true" : "false");
                    checkbox.disabled = true;

                    try {
                        const response = await fetch(form.action, {
                            method: "POST",
                            body: formData,
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });

                        let result;
                        try {
                            result = await response.json();
                        } catch {
                            throw new Error("Máy chủ không trả về phản hồi hợp lệ. Vui lòng thử lại.");
                        }

                        if (!response.ok || result.success !== true) {
                            throw new Error(result.message || "Không thể cập nhật trạng thái thu.");
                        }

                        row.dataset.paid = result.isPaid ? "true" : "false";
                        label.textContent = result.isPaid ? "Đã thu" : "Chưa thu";
                        row.querySelectorAll(".amount-input").forEach(input => {
                            input.disabled = result.isPaid;
                        });
                        showFeedback(result.message, true);
                        updateSummary();
                    } catch (error) {
                        checkbox.checked = previousValue;
                        showFeedback(error.message || "Không thể cập nhật trạng thái thu.", false);
                    } finally {
                        checkbox.disabled = false;
                    }
                });
            });

            updateSummary();
        })();
    </script>
}
