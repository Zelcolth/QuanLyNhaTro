@model QuanLyNhaTro.Models.Invoice

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    var statusLabel = Model.Status switch
    {
        "Paid" => "Đã thanh toán",
        "PartiallyPaid" => "Thanh toán một phần",
        _ => "Chưa thanh toán"
    };
    var statusClass = Model.Status switch
    {
        "Paid" => "text-bg-success",
        "PartiallyPaid" => "text-bg-warning",
        _ => "text-bg-secondary"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Hóa đơn @Model.InvoiceCode</h1>
        <p class="text-muted mb-0">Kỳ hóa đơn @Model.BillingMonth.ToString("MM/yyyy") · Lập lúc @Model.IssuedAt.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge @statusClass">@statusLabel</span>
        <a asp-action="Index" asp-route-billingMonth="@Model.BillingMonth.ToString("yyyy-MM")" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="text-muted small">Khu nhà / phòng</div>
                <div class="fw-semibold">@Model.RoomLabelSnapshot</div>
            </div>
            <div class="col-12 col-md-4">
                <div class="text-muted small">Người thuê</div>
                <div class="fw-semibold">@Model.TenantNamesSnapshot</div>
            </div>
            <div class="col-12 col-md-4">
                <div class="text-muted small">Mã hợp đồng</div>
                <div class="fw-semibold">@Model.ContractCodeSnapshot</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h2 class="h5 mb-0">Chi tiết khoản thu</h2>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Khoản thu</th>
                    <th>Diễn giải</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Tiền thuê phòng</td>
                    <td>Giá thuê theo hợp đồng</td>
                    <td class="text-end">@Model.RentAmount.ToString("N0") VNĐ</td>
                </tr>
                <tr>
                    <td>Tiền điện</td>
                    <td>
                        Chỉ số: @Model.PreviousElectricityReading.ToString("N2") → @Model.CurrentElectricityReading.ToString("N2") kWh;
                        tiêu thụ @Model.ElectricityConsumption.ToString("N2") kWh × @Model.ElectricityUnitPrice.ToString("N0") VNĐ/kWh
                    </td>
                    <td class="text-end">@Model.ElectricityAmount.ToString("N0") VNĐ</td>
                </tr>
                <tr>
                    <td>Tiền nước</td>
                    <td>
                        Chỉ số: @Model.PreviousWaterReading.ToString("N2") → @Model.CurrentWaterReading.ToString("N2") m³;
                        tiêu thụ @Model.WaterConsumption.ToString("N2") m³ × @Model.WaterUnitPrice.ToString("N0") VNĐ/m³
                    </td>
                    <td class="text-end">@Model.WaterAmount.ToString("N0") VNĐ</td>
                </tr>
                <tr>
                    <td>Phí rác</td>
                    <td>Phụ phí theo cấu hình tại thời điểm lập hóa đơn</td>
                    <td class="text-end">@Model.GarbageFee.ToString("N0") VNĐ</td>
                </tr>
                <tr>
                    <td>Phí Wi-Fi</td>
                    <td>Phụ phí theo cấu hình tại thời điểm lập hóa đơn</td>
                    <td class="text-end">@Model.WifiFee.ToString("N0") VNĐ</td>
                </tr>
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <th colspan="2" class="text-end">Tổng cộng</th>
                    <th class="text-end fs-5">@Model.TotalAmount.ToString("N0") VNĐ</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="alert alert-secondary mt-3 mb-0">
        <strong>Ghi chú:</strong> @Model.Notes
    </div>
}
