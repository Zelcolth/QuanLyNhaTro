@model QuanLyNhaTro.Models.Receipt

@{
    Layout = null;
    ViewData["Title"] = "Phiếu thu";
    var invoice = Model.Invoice;
    var totalPaid = invoice.Receipts
        .Where(item => item.ReceivedAt < Model.ReceivedAt
            || (item.ReceivedAt == Model.ReceivedAt && item.ReceiptId <= Model.ReceiptId))
        .Sum(item => item.Amount);
    var remaining = Math.Max(invoice.TotalAmount - totalPaid, 0m);
    var isCash = Model.PaymentMethod == "Cash";
    var isBankTransfer = Model.PaymentMethod == "BankTransfer";
    var paymentMethodLabel = isCash ? "Tiền mặt"
        : isBankTransfer ? "Chuyển khoản"
        : "Chưa xác định (phiếu cũ)";
    var payerName = string.IsNullOrWhiteSpace(Model.PayerName)
        ? "Chưa ghi nhận"
        : Model.PayerName;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Phiếu thu @Model.ReceiptCode</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #f3f4f6; color: #212529; }
        .invoice-paper { max-width: 850px; margin: 32px auto; padding: 42px; background: #fff; }
        .receipt-table th, .receipt-table td { padding: 11px 12px; }
        .amount { white-space: nowrap; text-align: right; }
        .signature-space { height: 80px; }
        @@media print {
            @@page { size: A5 portrait; margin: 10mm; }
            body { background: #fff; }
            .invoice-paper { max-width: none; margin: 0; padding: 0; }
            .no-print { display: none !important; }
            .table { --bs-table-bg: #fff; }
        }
    </style>
</head>
<body>
    <div class="no-print text-center py-3">
        <button type="button" class="btn btn-primary" onclick="window.print()">In phiếu thu</button>
        <a class="btn btn-outline-secondary" href="@Url.Action("Details", "Invoice", new { id = invoice.InvoiceId })">Quay lại hóa đơn</a>
    </div>

    <main class="invoice-paper border rounded">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1">PHIẾU THU</h1>
                <div class="text-muted">Ngày nhận tiền: @Model.ReceivedAt.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="text-end">
                <div><strong>Mã phiếu:</strong> @Model.ReceiptCode</div>
                <div><strong>Mã hóa đơn:</strong> @invoice.InvoiceCode</div>
                <div><strong>Phương thức:</strong> @paymentMethodLabel</div>
            </div>
        </div>

        <hr />

        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="text-muted small">Khu nhà / phòng</div>
                <strong>@invoice.RoomLabelSnapshot</strong>
            </div>
            <div class="col-md-7">
                <div class="text-muted small">Người thuê theo hóa đơn</div>
                <strong>@invoice.TenantNamesSnapshot</strong>
            </div>
            <div class="col-md-5">
                <div class="text-muted small">Người @(isBankTransfer ? "chuyển" : "nộp") tiền</div>
                <strong>@payerName</strong>
            </div>
        </div>

        <table class="table table-bordered receipt-table align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nội dung</th>
                    <th>Diễn giải</th>
                    <th class="amount">Số tiền</th>
                </tr>
            </thead>
            <tbody>
            @{
                var paymentIndex = 0;
            }
            @foreach (var payment in invoice.Receipts
                .OrderBy(item => item.ReceivedAt)
                .ThenBy(item => item.ReceiptId))
            {
                paymentIndex++;
                var paymentMethod = payment.PaymentMethod == "Cash"
                    ? "Tiền mặt"
                    : payment.PaymentMethod == "BankTransfer"
                        ? "Chuyển khoản"
                        : "Khác";
                <tr class="@(payment.ReceiptId == Model.ReceiptId ? "table-primary" : "")">
                    <td>Thanh toán lần @paymentIndex</td>
                    <td>
                        @payment.ReceivedAt.ToString("dd/MM/yyyy") — @payment.ReceiptCode<br />
                        <span class="small text-muted">@paymentMethod</span>
                        @if (payment.ReceiptId == Model.ReceiptId)
                        {
                            <span class="small text-muted"> (phiếu này)</span>
                        }
                    </td>
                    <td class="amount">@payment.Amount.ToString("N0") đ</td>
                </tr>
            }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <th colspan="2" class="text-end">Tổng tiền hóa đơn</th>
                    <th class="amount">@invoice.TotalAmount.ToString("N0") đ</th>
                </tr>
                <tr>
                    <th colspan="2" class="text-end">Tổng đã thu sau phiếu này</th>
                    <th class="amount">@totalPaid.ToString("N0") đ</th>
                </tr>
                <tr>
                    <th colspan="2" class="text-end">Còn phải thu</th>
                    <th class="amount">@remaining.ToString("N0") đ</th>
                </tr>
            </tfoot>
        </table>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="mt-3"><strong>Ghi chú:</strong> @Model.Notes</div>
        }

        @if (isBankTransfer)
        {
            <div class="alert alert-light border text-center mt-4">
                Khoản tiền đã được người quản lý xác nhận sau khi đối chiếu tài khoản ngân hàng.
            </div>
        }
        else if (!isCash)
        {
            <div class="alert alert-secondary text-center mt-4">
                Phiếu thu được lập trước khi hệ thống lưu phương thức và người nộp tiền.
            </div>
        }

        <div class="row text-center mt-5 pt-3">
            <div class="col-6">
                <strong>Người @(isBankTransfer ? "chuyển" : "nộp") tiền</strong>
                <div class="signature-space"></div>
                <div class="fw-semibold">@payerName</div>
            </div>
            <div class="col-6">
                <strong>Người thu tiền</strong>
                <div class="signature-space"></div>
                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.CollectorName) ? "Quản lý nhà trọ" : Model.CollectorName)</div>
            </div>
        </div>

        <div class="text-end small text-muted mt-4">Lập lúc @DateTime.Now.ToString("HH:mm dd/MM/yyyy")</div>
    </main>
</body>
</html>
