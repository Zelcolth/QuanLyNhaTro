@model QuanLyNhaTro.ViewModels.RoomOccupantsViewModel

<div class="modal-header">
    <div>
        <h5 class="modal-title" id="occupantsModalLabel">Người ở — @Model.RoomLabel</h5>
        @if (Model.ContractId.HasValue)
        {
            <small class="text-muted">Hợp đồng: @Model.ContractCode</small>
        }
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>

<div class="modal-body">
    @if (Model.ContractId is null)
    {
        <div class="alert alert-info mb-0">
            Phòng hiện không có hợp đồng đang hiệu lực. Chỉ có thể quản lý người ở khi hợp đồng đã được kích hoạt.
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <strong>Danh sách người đang ở</strong>
            <span class="text-muted small">@Model.ActiveOccupants.Count / @Model.MaxOccupants người</span>
        </div>

        <div class="card mb-3">
            <div class="card-header"><strong>Thêm người ở phụ</strong></div>
            <div class="card-body">
                @if (Model.ActiveOccupants.Count >= Model.MaxOccupants)
                {
                    <div class="alert alert-warning mb-0">Phòng đã đạt giới hạn số người tối đa.</div>
                }
                else if (Model.AvailableTenants.Count == 0)
                {
                    <div class="text-muted">Không còn hồ sơ người thuê phù hợp để thêm.</div>
                }
                else
                {
                    <form asp-controller="Room" asp-action="AddOccupant" asp-route-id="@Model.RoomId" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-2 align-items-end">
                            <div class="col-md-6">
                                <label for="newOccupantTenantId" class="form-label">Người thuê</label>
                                <select id="newOccupantTenantId" name="tenantId" class="form-select" required>
                                    <option value="">-- Chọn người thuê --</option>
                                    @foreach (var tenant in Model.AvailableTenants)
                                    {
                                        <option value="@tenant.TenantId">
                                            @tenant.FullName — @(string.IsNullOrWhiteSpace(tenant.Phone) ? "Chưa có SĐT" : tenant.Phone)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="newOccupantRelationship" class="form-label">Quan hệ</label>
                                <input id="newOccupantRelationship" name="relationshipToPrimaryTenant"
                                       class="form-control" maxlength="100" placeholder="Bạn cùng thuê, vợ/chồng..." />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">Thêm</button>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>

        @if (Model.ActiveOccupants.Count == 0)
        {
            <div class="alert alert-warning">Hợp đồng chưa có người đang ở được ghi nhận.</div>
        }
        else
        {
            @foreach (var assignment in Model.ActiveOccupants)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <strong>@assignment.Tenant.FullName</strong>
                                @if (assignment.IsPrimaryTenant)
                                {
                                    <span class="badge text-bg-primary ms-1">Người đứng tên</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary ms-1">Người ở phụ</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(assignment.RelationshipToPrimaryTenant))
                                {
                                    <div class="small text-muted">Quan hệ: @assignment.RelationshipToPrimaryTenant</div>
                                }
                                <div class="small text-muted mt-1">
                                    SĐT: @(string.IsNullOrWhiteSpace(assignment.Tenant.Phone) ? "Chưa có" : assignment.Tenant.Phone)
                                    · Năm sinh: @(assignment.Tenant.BirthYear?.ToString() ?? assignment.Tenant.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa có")
                                    · CCCD/CMND: @(string.IsNullOrWhiteSpace(assignment.Tenant.IdentityNumber) ? "Chưa có" : assignment.Tenant.IdentityNumber)
                                </div>
                                <div class="small text-muted">Ghi nhận từ: @(assignment.JoinedAt?.ToString("dd/MM/yyyy") ?? "Chưa có dữ liệu")</div>
                            </div>
                            @if (!assignment.IsPrimaryTenant)
                            {
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <form asp-controller="Room" asp-action="MarkOccupantLeft" asp-route-id="@Model.RoomId"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Ghi nhận người này đã rời khỏi phòng?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tenantId" value="@assignment.TenantId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Đã rời đi</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        @if (Model.FormerOccupants.Count > 0)
        {
            <div class="mt-4">
                <h6 class="mb-2">Lịch sử người ở phụ</h6>
                @foreach (var assignment in Model.FormerOccupants)
                {
                    <div class="border rounded p-2 mb-2">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <strong>@assignment.Tenant.FullName</strong>
                            <span class="badge text-bg-light">Đã rời đi</span>
                        </div>
                        <div class="small text-muted">
                            SĐT: @(string.IsNullOrWhiteSpace(assignment.Tenant.Phone) ? "Chưa có" : assignment.Tenant.Phone)
                            · Rời đi: @(assignment.LeftAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa ghi nhận")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(assignment.RelationshipToPrimaryTenant))
                        {
                            <div class="small text-muted">Quan hệ: @assignment.RelationshipToPrimaryTenant</div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
</div>
