@model QuanLyNhaTro.Models.RentalContract

@{
    ViewData["Title"] = "Chi tiết hợp đồng thuê";
    var statusText = Model.Status switch
    {
        "Draft" => "Bản nháp",
        "Active" => "Đang hiệu lực",
        "Expired" => "Hết hạn",
        "Terminated" => "Đã chấm dứt",
        "Completed" => "Đã hoàn thành (hợp đồng cũ)",
        "Cancelled" => "Đã hủy (hợp đồng cũ)",
        _ => Model.Status
    };
    var primaryTenant = Model.ContractTenants.FirstOrDefault(item => item.IsPrimaryTenant);
    var otherTenants = Model.ContractTenants
        .Where(item => !item.IsPrimaryTenant && item.IsActive)
        .OrderBy(item => item.Tenant.FullName)
        .ToList();
    var formerTenants = Model.ContractTenants
        .Where(item => !item.IsPrimaryTenant && !item.IsActive)
        .OrderByDescending(item => item.LeftAt)
        .ThenBy(item => item.Tenant.FullName)
        .ToList();
}

<h1>Chi tiết hợp đồng thuê</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Mã hợp đồng</dt>
            <dd class="col-sm-8">@Model.ContractCode</dd>

            <dt class="col-sm-4">Phòng</dt>
            <dd class="col-sm-8">@Model.Room.Building.BuildingName - @Model.Room.RoomCode</dd>

            <dt class="col-sm-4">Người đứng tên hợp đồng</dt>
            <dd class="col-sm-8">
                @if (primaryTenant is null)
                {
                    <span class="text-muted">Chưa có người đứng tên</span>
                }
                else
                {
                    <strong>@primaryTenant.Tenant.FullName</strong>
                }
            </dd>

            <dt class="col-sm-4">Người ở cùng</dt>
            <dd class="col-sm-8">
                @if (otherTenants.Count == 0)
                {
                    <span class="text-muted">Chưa thêm người ở phụ</span>
                }
                else
                {
                    <ul class="mb-0">
                        @foreach (var assignment in otherTenants)
                        {
                            <li>
                                @assignment.Tenant.FullName
                                @if (!string.IsNullOrWhiteSpace(assignment.RelationshipToPrimaryTenant))
                                {
                                    <small class="text-muted">(@assignment.RelationshipToPrimaryTenant)</small>
                                }
                            </li>
                        }
                    </ul>
                }
            </dd>

            @if (formerTenants.Count > 0)
            {
                <dt class="col-sm-4">Người ở phụ đã rời đi</dt>
                <dd class="col-sm-8">
                    <ul class="mb-0">
                        @foreach (var assignment in formerTenants)
                        {
                            <li>
                                @assignment.Tenant.FullName
                                <small class="text-muted"> — Rời đi: @(assignment.LeftAt?.ToString("dd/MM/yyyy") ?? "Chưa ghi nhận")</small>
                            </li>
                        }
                    </ul>
                </dd>
            }

            <dt class="col-sm-4">Ngày bắt đầu</dt>
            <dd class="col-sm-8">@Model.StartDate.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-4">Ngày kết thúc theo hợp đồng</dt>
            <dd class="col-sm-8">@Model.EndDate.ToString("dd/MM/yyyy")</dd>
            @if (Model.ActualEndDate.HasValue)
            {
                <dt class="col-sm-4">Ngày chấm dứt thực tế</dt>
                <dd class="col-sm-8">@Model.ActualEndDate.Value.ToString("dd/MM/yyyy")</dd>
            }
            <dt class="col-sm-4">Giá thuê thỏa thuận hàng tháng</dt>
            <dd class="col-sm-8">@Model.MonthlyRent.ToString("N0")</dd>
            <dt class="col-sm-4">Tiền đặt cọc</dt>
            <dd class="col-sm-8">@Model.Deposit.ToString("N0")</dd>
            <dt class="col-sm-4">Trạng thái</dt>
            <dd class="col-sm-8">@statusText</dd>
            <dt class="col-sm-4">Điều khoản</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Terms) ? "Chưa có" : Model.Terms)</dd>
        </dl>
    </div>
</div>

@if (Model.Status == "Active")
{
    <div class="card mb-3">
        <div class="card-header"><strong>Thông tin hẹn trả phòng</strong></div>
        <div class="card-body">
            <form asp-action="SetMoveOutDate" asp-route-id="@Model.ContractId" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-5">
                    <label for="expectedMoveOutDate" class="form-label">Ngày khách dự kiến trả phòng</label>
                    <input type="date" name="expectedMoveOutDate" id="expectedMoveOutDate"
                           class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           max="@Model.EndDate.ToString("yyyy-MM-dd")"
                           value="@(Model.ExpectedMoveOutDate?.ToString("yyyy-MM-dd") ?? string.Empty)" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-outline-primary">Lưu ngày hẹn</button>
                </div>
                @if (Model.ExpectedMoveOutDate.HasValue)
                {
                    <div class="col-12 text-warning-emphasis">
                        <span class="badge text-bg-warning">Khách hẹn trả phòng</span>
                        Dự kiến: @Model.ExpectedMoveOutDate.Value.ToString("dd/MM/yyyy")
                    </div>
                }
                <div class="col-12 small text-muted">Để trống ngày và lưu để xóa thông tin hẹn trả phòng.</div>
            </form>
        </div>
    </div>
}

<div class="d-flex gap-2 flex-wrap">
    @if (Model.Status == "Draft")
    {
        <a asp-action="Edit" asp-route-id="@Model.ContractId" class="btn btn-primary">Sửa thông tin</a>
        <form asp-action="Activate" asp-route-id="@Model.ContractId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success"
                    onclick="return confirm('Kích hoạt hợp đồng với duy nhất người đứng tên đã chọn? Có thể bổ sung người ở phụ sau khi kích hoạt.');">
                Kích hoạt hợp đồng
            </button>
        </form>
        <a asp-action="Delete" asp-route-id="@Model.ContractId" class="btn btn-outline-danger">Xóa bản nháp</a>
    }
    @if (Model.Status == "Active")
    {
        <a asp-action="Edit" asp-route-id="@Model.ContractId" class="btn btn-outline-primary">Sửa thông tin hợp đồng</a>
        <form asp-action="EndContract" asp-route-id="@Model.ContractId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning"
                    onclick="return confirm('Xác nhận người thuê đã trả phòng và chấm dứt hợp đồng trước hạn?');">
                Kết thúc hợp đồng
            </button>
        </form>
    }
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>
