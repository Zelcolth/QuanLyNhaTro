@model IEnumerable<QuanLyNhaTro.Models.Invoice>
@using System.Globalization

@{
    ViewData["Title"] = "Quản lý hóa đơn";
    var billingMonth = ViewBag.BillingMonth as string ?? DateTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    var currentMonth = ViewBag.CurrentMonth as string ?? DateTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    var parsedMonth = DateTime.ParseExact(billingMonth, "yyyy-MM", CultureInfo.InvariantCulture);
    var previousMonth = parsedMonth.AddMonths(-1);
    var invoices = Model.ToList();
    var roomOptions = invoices
        .Select(invoice => invoice.RoomLabelSnapshot)
        .Where(label => !string.IsNullOrWhiteSpace(label))
        .Distinct()
        .OrderBy(label => label)
        .ToList();
    var paidCount = invoices.Count(invoice => invoice.Status == "Paid");
    var unpaidCount = invoices.Count - paidCount;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <h1>Quản lý hóa đơn</h1>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="UtilityReading" asp-action="Index" asp-route-readingMonth="@billingMonth"
           class="btn btn-outline-secondary">Nhập chỉ số điện nước</a>
        <form asp-action="GenerateMonth" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="billingMonth" value="@billingMonth" />
            <button type="submit" class="btn btn-primary">Lập hóa đơn tháng này</button>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (TempData["GenerationWarnings"] is string warnings)
{
    <div class="alert alert-warning" role="alert">
        <strong>Một số phòng chưa được lập hóa đơn:</strong> @warnings
    </div>
}

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label for="billingMonth" class="form-label">Kỳ hóa đơn</label>
        <input id="billingMonth" name="billingMonth" type="month" value="@billingMonth"
               max="@currentMonth" class="form-control" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Xem hóa đơn</button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="small text-secondary mb-1">Tổng hóa đơn trong kỳ</div>
                <div class="fs-3 fw-semibold">@invoices.Count</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="small text-secondary mb-1">Đã thu</div>
                <div class="fs-3 fw-semibold">@paidCount</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="small text-secondary mb-1">Chưa thu</div>
                <div class="fs-3 fw-semibold">@unpaidCount</div>
                <div class="small text-secondary">Tổng còn phải thu: @invoices.Where(invoice => invoice.Status != "Paid").Sum(invoice => invoice.TotalAmount).ToString("N0") VNĐ</div>
            </div>
        </div>
    </div>
</div>

<div class="mb-3">
    <label for="roomFilter" class="form-label">Lọc phòng</label>
    <select id="roomFilter" class="form-select" style="max-width: 360px;">
        <option value="">Tất cả phòng</option>
        @foreach (var room in roomOptions)
        {
            <option value="@room">@room</option>
        }
    </select>
</div>

@if (invoices.Count == 0)
{
    <div class="alert alert-info">
        Chưa có hóa đơn cho kỳ @parsedMonth.ToString("MM/yyyy"). Nhập chỉ số điện nước đầy đủ, sau đó nhấn “Lập hóa đơn tháng này”.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Phòng / mã hóa đơn</th>
                    <th>Người thuê</th>
                    <th class="text-end">Tiền phòng</th>
                    <th class="text-end">Điện @previousMonth.ToString("MM/yyyy")</th>
                    <th class="text-end">Điện @parsedMonth.ToString("MM/yyyy")</th>
                    <th class="text-end">Số điện</th>
                    <th class="text-end">Nước @previousMonth.ToString("MM/yyyy")</th>
                    <th class="text-end">Nước @parsedMonth.ToString("MM/yyyy")</th>
                    <th class="text-end">Số nước</th>
                    <th class="text-end">Rác</th>
                    <th class="text-end">Internet</th>
                    <th class="text-end">Nợ tháng trước</th>
                    <th>Tiền giảm trừ</th>
                    <th class="text-end">Tổng cần thu</th>
                    <th>Trạng thái thu</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var invoice in invoices)
            {
                var isPaid = invoice.Status == "Paid";
                var amountBeforeDiscount = invoice.RentAmount
                    + invoice.ElectricityAmount
                    + invoice.WaterAmount
                    + invoice.GarbageFee
                    + invoice.WifiFee
                    + invoice.PreviousDebtAmount;

                <tr data-invoice-row data-room-key="@invoice.RoomLabelSnapshot">
                    <td>
                        <div class="fw-semibold">@invoice.RoomLabelSnapshot</div>
                        <div class="small text-secondary">@invoice.InvoiceCode</div>
                    </td>
                    <td>@invoice.TenantNamesSnapshot</td>
                    <td class="text-end">@invoice.RentAmount.ToString("N0")</td>
                    <td class="text-end">@invoice.PreviousElectricityReading.ToString("N2")</td>
                    <td class="text-end">@invoice.CurrentElectricityReading.ToString("N2")</td>
                    <td class="text-end">@invoice.ElectricityConsumption.ToString("N2")</td>
                    <td class="text-end">@invoice.PreviousWaterReading.ToString("N2")</td>
                    <td class="text-end">@invoice.CurrentWaterReading.ToString("N2")</td>
                    <td class="text-end">@invoice.WaterConsumption.ToString("N2")</td>
                    <td class="text-end">@invoice.GarbageFee.ToString("N0")</td>
                    <td class="text-end">@invoice.WifiFee.ToString("N0")</td>
                    <td class="text-end">@invoice.PreviousDebtAmount.ToString("N0")</td>
                    <td>
                        <form asp-action="UpdateDiscount" method="post" class="d-flex align-items-center gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@invoice.InvoiceId" />
                            <input type="hidden" name="billingMonth" value="@billingMonth" />
                            <input type="number" name="discountAmount"
                                   class="form-control form-control-sm" style="min-width: 105px;"
                                   value="@invoice.DiscountAmount.ToString(CultureInfo.InvariantCulture)"
                                   min="0" max="@amountBeforeDiscount.ToString(CultureInfo.InvariantCulture)"
                                   step="1" required
                                   disabled="@(isPaid ? "disabled" : null)" aria-label="Tiền giảm trừ hóa đơn @invoice.InvoiceCode" />
                            <button type="submit" class="btn btn-sm btn-outline-primary"
                                    disabled="@(isPaid ? "disabled" : null)" title="Lưu tiền giảm trừ">Lưu</button>
                        </form>
                    </td>
                    <td class="text-end fw-semibold">@invoice.TotalAmount.ToString("N0") VNĐ</td>
                    <td>@(isPaid ? "Đã thu" : "Chưa thu")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            <a asp-action="Details" asp-route-id="@invoice.InvoiceId"
                               class="btn btn-sm btn-outline-primary">Chi tiết</a>
                            <form asp-action="UpdatePaymentStatus" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@invoice.InvoiceId" />
                                <input type="hidden" name="billingMonth" value="@billingMonth" />
                                <input type="hidden" name="isPaid" value="@(!isPaid)" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(isPaid ? "Chuyển về chưa thu" : "Đánh dấu đã thu")
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const roomFilter = document.getElementById("roomFilter");
            if (!roomFilter) return;

            const rows = Array.from(document.querySelectorAll("[data-invoice-row]"));
            roomFilter.addEventListener("change", () => {
                const selectedRoom = roomFilter.value;
                rows.forEach(row => {
                    row.hidden = selectedRoom !== "" && row.dataset.roomKey !== selectedRoom;
                });
            });
        })();
    </script>
}
