@model QuanLyNhaTro.ViewModels.MoveOutSettlementViewModel

@{
    ViewData["Title"] = "Phiếu quyết toán tiền đặt cọc";
    var isConfirmed = Model.Status == "Confirmed";
}

<h1>Phiếu quyết toán tiền đặt cọc</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="card mb-3">
    <div class="card-header"><strong>Thông tin trả phòng</strong></div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã hợp đồng</dt><dd class="col-sm-9">@Model.ContractCode</dd>
            <dt class="col-sm-3">Phòng</dt><dd class="col-sm-9">@Model.RoomLabel</dd>
            <dt class="col-sm-3">Người thuê</dt><dd class="col-sm-9">@Model.TenantNames</dd>
            <dt class="col-sm-3">Ngày trả phòng</dt><dd class="col-sm-9">@Model.MoveOutDate.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Trạng thái phiếu</dt>
            <dd class="col-sm-9">@(isConfirmed ? "Đã xác nhận trả phòng" : "Bản nháp")</dd>
        </dl>
    </div>
</div>

@if (!isConfirmed && !Model.HasCurrentMonthInvoice)
{
    <div class="alert alert-warning">
        Chưa có hóa đơn tháng trả phòng. Hãy <a asp-controller="Invoice" asp-action="Index" asp-route-billingMonth="@Model.MoveOutDate.ToString("yyyy-MM")">mở hóa đơn tháng @Model.MoveOutDate.ToString("MM/yyyy")</a> và lập hóa đơn trước khi xác nhận trả phòng.
    </div>
}

<div class="card mb-3">
    <div class="card-header"><strong>Các khoản quyết toán</strong></div>
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle mb-0">
            <tbody>
                <tr><th>Tiền đặt cọc</th><td class="text-end">@Model.DepositAmount.ToString("N0") đ</td></tr>
                <tr><th>Công nợ hóa đơn chưa thanh toán</th><td class="text-end">@Model.OutstandingInvoiceAmount.ToString("N0") đ</td></tr>
                @if (isConfirmed && !Model.IsInvoiceReconciled)
                {
                    <tr><th>Tiền điện (@Model.PreviousElectricityReading.ToString("N2") → @Model.FinalElectricityReading.ToString("N2") kWh)</th><td class="text-end">@Model.ElectricityAmount.ToString("N0") đ</td></tr>
                    <tr><th>Tiền nước (@Model.PreviousWaterReading.ToString("N2") → @Model.FinalWaterReading.ToString("N2") m³)</th><td class="text-end">@Model.WaterAmount.ToString("N0") đ</td></tr>
                    <tr><th>Phí rác</th><td class="text-end">@Model.GarbageFee.ToString("N0") đ</td></tr>
                }
                else
                {
                    <tr><th>Tiền điện đối chiếu (@Model.PreviousElectricityReading.ToString("N2") → @Model.FinalElectricityReading.ToString("N2") kWh)</th><td class="text-end">@Model.ElectricityAmount.ToString("N0") đ <small class="text-muted">(@(Model.HasCurrentMonthInvoice ? "đã tính trong hóa đơn" : "sẽ tính trong hóa đơn"))</small></td></tr>
                    <tr><th>Tiền nước đối chiếu (@Model.PreviousWaterReading.ToString("N2") → @Model.FinalWaterReading.ToString("N2") m³)</th><td class="text-end">@Model.WaterAmount.ToString("N0") đ <small class="text-muted">(@(Model.HasCurrentMonthInvoice ? "đã tính trong hóa đơn" : "sẽ tính trong hóa đơn"))</small></td></tr>
                    <tr><th>Điều chỉnh hóa đơn tháng trả phòng</th><td class="text-end fw-semibold">@(Model.InvoiceAdjustmentAmount > 0 ? "+" : "")@Model.InvoiceAdjustmentAmount.ToString("N0") đ</td></tr>
                }
                <tr><th>Phí vệ sinh</th><td class="text-end">@Model.CleaningFee.ToString("N0") đ</td></tr>
                <tr><th>Phí sửa chữa</th><td class="text-end">@Model.RepairFee.ToString("N0") đ</td></tr>
                <tr><th>Chi phí khác</th><td class="text-end">@Model.OtherFee.ToString("N0") đ</td></tr>
            </tbody>
            <tfoot>
                <tr><th>Tổng khấu trừ</th><th class="text-end">@Model.TotalDeductions.ToString("N0") đ</th></tr>
                <tr><th>Tiền cọc hoàn trả</th><th class="text-end text-success">@Model.RefundAmount.ToString("N0") đ</th></tr>
                <tr><th>Người thuê cần thanh toán thêm</th><th class="text-end text-danger">@Model.AdditionalAmountDue.ToString("N0") đ</th></tr>
            </tfoot>
        </table>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="card-body border-top"><strong>Ghi chú:</strong> @Model.Notes</div>
    }
</div>

<div class="alert alert-info">
    @if (isConfirmed && !Model.IsInvoiceReconciled)
    {
        <span>Phiếu quyết toán này được lập theo cách tính cũ trước khi hệ thống đối soát hóa đơn tháng trả phòng.</span>
    }
    else if (!Model.HasCurrentMonthInvoice)
    {
        <span>Tiền phòng, điện nước và phí định kỳ tháng trả phòng sẽ được đưa vào hóa đơn. Cần lập hóa đơn trước khi xác nhận trả phòng.</span>
    }
    else
    {
        <span>Tiền phòng, điện nước và phí định kỳ tháng trả phòng đã được đối soát qua hóa đơn.</span>
    }
    Việc thực tế hoàn tiền cọc hoặc thu thêm chưa được ghi nhận là giao dịch thanh toán.
</div>

<div class="d-flex gap-2 flex-wrap">
    <a asp-action="Print" asp-route-id="@Model.SettlementId" target="_blank" class="btn btn-outline-primary">In phiếu</a>
    @if (!isConfirmed)
    {
        <a asp-action="Create" asp-route-contractId="@Model.ContractId" class="btn btn-outline-secondary">Chỉnh sửa phiếu</a>
        <form asp-action="Confirm" asp-route-id="@Model.SettlementId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger" disabled="@(!Model.HasCurrentMonthInvoice)"
                    onclick="return confirm('Xác nhận trả phòng? Hợp đồng sẽ chấm dứt và phòng chuyển sang trạng thái Chờ xử lý.');">
                Xác nhận trả phòng
            </button>
        </form>
    }
    <a asp-controller="RentalContract" asp-action="Details" asp-route-id="@Model.ContractId" class="btn btn-secondary">Quay lại hợp đồng</a>
</div>
