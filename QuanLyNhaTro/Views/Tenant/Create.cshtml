@model QuanLyNhaTro.Models.TenantProfile

@{
    ViewData["Title"] = "Thêm người thuê";
}

<h1>Thêm người thuê</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Họ và tên</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label">Số điện thoại (không bắt buộc)</label>
        <input asp-for="Phone" type="tel" class="form-control" />
        <div class="form-text">Có thể để trống nếu người thuê chưa có số điện thoại riêng.</div>
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="IdentityNumber" class="form-label">Số CCCD/CMND</label>
        <input asp-for="IdentityNumber" class="form-control" />
        <span asp-validation-for="IdentityNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label">Ngày sinh đầy đủ (nếu biết)</label>
        <input asp-for="DateOfBirth" type="date" class="form-control" />
        <div class="form-text">Chỉ nhập khi biết chính xác ngày, tháng và năm sinh.</div>
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BirthYear" class="form-label">Năm sinh (nếu chỉ biết năm)</label>
        <input asp-for="BirthYear" type="number" class="form-control" />
        <div class="form-text">Nhập năm sinh nếu không biết đủ ngày/tháng. Không nhập đồng thời với ngày sinh đầy đủ.</div>
        <span asp-validation-for="BirthYear" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PermanentAddress" class="form-label">Địa chỉ thường trú</label>
        <textarea asp-for="PermanentAddress" class="form-control" rows="3"></textarea>
        <span asp-validation-for="PermanentAddress" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Ghi chú</label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        if (window.jQuery && $.validator) {
            $.validator.messages.number =
                "Năm sinh phải là số nguyên hợp lệ.";
        }
    </script>
}
