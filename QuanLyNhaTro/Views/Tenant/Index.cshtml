@model IEnumerable<QuanLyNhaTro.Models.TenantProfile>

@{
    ViewData["Title"] = "Quản lý người thuê";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý người thuê</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm người thuê</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có người thuê nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Họ và tên</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Số CCCD/CMND</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var tenant in Model)
            {
                <tr>
                    <td>@tenant.FullName</td>
                    <td>@tenant.Phone</td>
                    <td>@(tenant.Email ?? "Chưa có")</td>
                    <td>@(tenant.IdentityNumber ?? "Chưa có")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@tenant.TenantId" class="btn btn-sm btn-outline-info">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@tenant.TenantId" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@tenant.TenantId" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
