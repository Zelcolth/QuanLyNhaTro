@model IEnumerable<QuanLyNhaTro.Models.Room>

@{
    ViewData["Title"] = "Quản lý phòng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý phòng</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm phòng</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="small text-secondary mb-1">Tổng số phòng</div>
                <div class="fs-3 fw-semibold">@ViewBag.TotalRooms</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="small text-secondary mb-1">Phòng trống</div>
                <div class="fs-3 fw-semibold">@ViewBag.AvailableRooms</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="small text-secondary mb-1">Đang thuê</div>
                <div class="fs-3 fw-semibold">@ViewBag.OccupiedRooms</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="small text-secondary mb-1">Bảo trì</div>
                <div class="fs-3 fw-semibold">@ViewBag.MaintenanceRooms</div>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có phòng nào.</div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tòa nhà</th>
                    <th>Mã phòng</th>
                    <th>Giá thuê niêm yết/tháng</th>
                    <th>Số người tối đa</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var room in Model)
            {
                var statusText = room.Status switch
                {
                    "Available" => "Trống",
                    "Occupied" => "Đang thuê",
                    "Maintenance" => "Bảo trì",
                    _ => room.Status
                };
                <tr>
                    <td>@room.Building.BuildingName</td>
                    <td>@room.RoomCode</td>
                    <td>@room.MonthlyRent.ToString("N0")</td>
                    <td>@room.MaxOccupants</td>
                    <td>@statusText</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@room.RoomId" class="btn btn-sm btn-outline-info">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@room.RoomId" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@room.RoomId" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
}
