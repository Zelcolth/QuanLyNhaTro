@model IEnumerable<QuanLyNhaTro.Models.Invoice>
@using System.Globalization

@{
    ViewData["Title"] = "Quản lý hóa đơn";
    var billingMonth = ViewBag.BillingMonth as string ?? DateTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    var currentMonth = ViewBag.CurrentMonth as string ?? DateTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    var parsedMonth = DateTime.ParseExact(billingMonth, "yyyy-MM", CultureInfo.InvariantCulture);
    var previousMonth = parsedMonth.AddMonths(-1);
    var invoices = Model.ToList();
    var roomOptions = invoices.Select(invoice => invoice.RoomLabelSnapshot)
        .Where(label => !string.IsNullOrWhiteSpace(label))
        .Distinct()
        .OrderBy(label => label)
        .ToList();
    var paidCount = invoices.Count(invoice => invoice.Status == "Paid");
    var unpaidCount = invoices.Count - paidCount;
    var collectedAmount = invoices.Where(invoice => invoice.Status == "Paid").Sum(invoice => invoice.TotalAmount);
    var outstandingAmount = invoices.Where(invoice => invoice.Status != "Paid").Sum(invoice => invoice.TotalAmount);
    var electricityTotal = invoices.Sum(invoice => invoice.ElectricityAmount);
    var waterTotal = invoices.Sum(invoice => invoice.WaterAmount);
    var revenueTotal = invoices.Sum(invoice => invoice.TotalAmount);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">Hóa đơn @ViewBag.BillingMonthLabel</h1>
        <div class="text-muted">Quản lý và theo dõi thu tiền theo kỳ</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="UtilityReading" asp-action="Index" asp-route-readingMonth="@billingMonth"
           class="btn btn-outline-secondary">Nhập chỉ số điện nước</a>
        <form asp-action="GenerateMonth" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="billingMonth" value="@billingMonth" />
            <button type="submit" class="btn btn-primary">Lập hóa đơn</button>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["GenerationWarnings"] is string warnings)
{
    <div class="alert alert-warning" role="alert">
        <strong>Cần kiểm tra một số phòng:</strong> @warnings
    </div>
}

<div id="paymentFeedback" class="alert d-none" role="status" aria-live="polite"></div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label for="billingMonth" class="form-label">Kỳ hóa đơn</label>
                <input id="billingMonth" name="billingMonth" type="month" value="@billingMonth"
                       max="@currentMonth" class="form-control" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Xem kỳ</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="small text-muted">Phòng chưa thu</div>
            <div class="fs-4 fw-semibold" id="unpaidCount">@unpaidCount</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="small text-muted">Phòng đã thu</div>
            <div class="fs-4 fw-semibold" id="paidCount">@paidCount</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="small text-muted">Tổng tiền đã thu</div>
            <div class="fw-semibold" id="collectedAmount">@collectedAmount.ToString("N0") đ</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="small text-muted">Tổng tiền chưa thu</div>
            <div class="fw-semibold" id="outstandingAmount">@outstandingAmount.ToString("N0") đ</div>
        </div></div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card h-100"><div class="card-body">
            <div class="small text-muted">Tổng tiền điện</div>
            <div class="fw-semibold" id="electricityTotal">@electricityTotal.ToString("N0") đ</div>
        </div></div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card h-100"><div class="card-body">
            <div class="small text-muted">Tổng tiền nước</div>
            <div class="fw-semibold" id="waterTotal">@waterTotal.ToString("N0") đ</div>
        </div></div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100"><div class="card-body">
            <div class="small text-muted">Tổng giá trị hóa đơn</div>
            <div class="fw-semibold" id="revenueTotal">@revenueTotal.ToString("N0") đ</div>
        </div></div>
    </div>
</div>

<div class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-4">
        <label for="roomFilter" class="form-label">Lọc theo phòng</label>
        <select id="roomFilter" class="form-select">
            <option value="">Tất cả phòng</option>
            @foreach (var room in roomOptions)
            {
                <option value="@room">@room</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-md-8 text-muted small">
        Có thể chỉnh tiền phòng, tiền rác, nợ tháng trước và tiền giảm ngay trên dòng hóa đơn chưa thu. Nợ tháng trước không tự động chuyển từ hóa đơn cũ.
    </div>
</div>

@if (invoices.Count == 0)
{
    <div class="alert alert-info">
        Chưa có hóa đơn kỳ @parsedMonth.ToString("MM/yyyy"). Nhập đủ chỉ số điện nước rồi chọn “Lập hóa đơn”.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã phòng / hóa đơn</th>
                    <th>Trạng thái thu</th>
                    <th>Người thuê</th>
                    <th class="text-end">Tiền phòng</th>
                    <th class="text-end">Điện cũ<br />@previousMonth.ToString("MM/yyyy")</th>
                    <th class="text-end">Điện mới<br />@parsedMonth.ToString("MM/yyyy")</th>
                    <th class="text-end">Số điện dùng</th>
                    <th class="text-end">Nước cũ<br />@previousMonth.ToString("MM/yyyy")</th>
                    <th class="text-end">Nước mới<br />@parsedMonth.ToString("MM/yyyy")</th>
                    <th class="text-end">Số nước dùng</th>
                    <th class="text-end">Tiền rác</th>
                    <th class="text-end">Internet</th>
                    <th class="text-end">Nợ tháng trước</th>
                    <th class="text-end">Tiền giảm</th>
                    <th class="text-end">Tổng tiền</th>
                    <th>Trạng thái HĐ</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var invoice in invoices)
            {
                var isPaid = invoice.Status == "Paid";
                var contractStatus = invoice.Contract?.Status ?? "";
                var contractStatusLabel = contractStatus switch
                {
                    "Active" => "Đang hiệu lực",
                    "Expired" => "Hết hạn",
                    "Terminated" => "Đã kết thúc",
                    "Draft" => "Bản nháp",
                    _ => contractStatus
                };
                var amountFormId = $"amount-form-{invoice.InvoiceId}";

                <tr data-invoice-row
                    data-room-key="@invoice.RoomLabelSnapshot"
                    data-paid="@(isPaid ? "true" : "false")"
                    data-total="@invoice.TotalAmount.ToString(CultureInfo.InvariantCulture)"
                    data-electricity="@invoice.ElectricityAmount.ToString(CultureInfo.InvariantCulture)"
                    data-water="@invoice.WaterAmount.ToString(CultureInfo.InvariantCulture)">
                    <td>
                        <form id="@amountFormId" asp-action="UpdateAmounts" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@invoice.InvoiceId" />
                            <input type="hidden" name="billingMonth" value="@billingMonth" />
                        </form>
                        <div class="fw-semibold">@invoice.RoomLabelSnapshot</div>
                        <div class="small text-muted">@invoice.InvoiceCode</div>
                    </td>
                    <td>
                        <form asp-action="UpdatePaymentStatus" method="post" class="payment-status-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@invoice.InvoiceId" />
                            <div class="form-check">
                                <input class="form-check-input payment-status-checkbox" type="checkbox"
                                       name="isPaid" value="true" checked="@(isPaid ? "checked" : null)"
                                       aria-label="Đánh dấu đã thu hóa đơn @invoice.InvoiceCode" />
                                <label class="form-check-label payment-status-label">@(isPaid ? "Đã thu" : "Chưa thu")</label>
                            </div>
                        </form>
                    </td>
                    <td>@invoice.TenantNamesSnapshot</td>
                    <td>
                        <input form="@amountFormId" name="rentAmount" type="number"
                               class="form-control form-control-sm amount-input" min="0" step="1000"
                               value="@invoice.RentAmount.ToString(CultureInfo.InvariantCulture)"
                               aria-label="Tiền phòng" required disabled="@isPaid" />
                    </td>
                    <td class="text-end text-nowrap">@invoice.PreviousElectricityReading.ToString("N2")</td>
                    <td class="text-end text-nowrap">@invoice.CurrentElectricityReading.ToString("N2")</td>
                    <td class="text-end text-nowrap">@invoice.ElectricityConsumption.ToString("N2")</td>
                    <td class="text-end text-nowrap">@invoice.PreviousWaterReading.ToString("N2")</td>
                    <td class="text-end text-nowrap">@invoice.CurrentWaterReading.ToString("N2")</td>
                    <td class="text-end text-nowrap">@invoice.WaterConsumption.ToString("N2")</td>
                    <td>
                        <input form="@amountFormId" name="garbageFee" type="number"
                               class="form-control form-control-sm amount-input" min="0" step="1000"
                               value="@invoice.GarbageFee.ToString(CultureInfo.InvariantCulture)"
                               aria-label="Tiền rác" required disabled="@isPaid" />
                    </td>
                    <td class="text-end text-nowrap">@invoice.WifiFee.ToString("N0") đ</td>
                    <td>
                        <input form="@amountFormId" name="previousDebtAmount" type="number"
                               class="form-control form-control-sm amount-input" min="0" step="1000"
                               value="@invoice.PreviousDebtAmount.ToString(CultureInfo.InvariantCulture)"
                               aria-label="Nợ tháng trước" required disabled="@isPaid" />
                    </td>
                    <td>
                        <input form="@amountFormId" name="discountAmount" type="number"
                               class="form-control form-control-sm amount-input" min="0" step="1000"
                               value="@invoice.DiscountAmount.ToString(CultureInfo.InvariantCulture)"
                               aria-label="Tiền giảm trừ" required disabled="@isPaid" />
                    </td>
                    <td class="text-end fw-semibold text-nowrap">@invoice.TotalAmount.ToString("N0") đ</td>
                    <td class="text-nowrap">@contractStatusLabel</td>
                    <td>
                        <div class="d-flex flex-column gap-1">
                            <button type="submit" form="@amountFormId" class="btn btn-sm btn-primary" disabled="@isPaid">
                                Lưu tiền
                            </button>
                            <a asp-action="Details" asp-route-id="@invoice.InvoiceId"
                               class="btn btn-sm btn-outline-secondary">Chi tiết HĐ</a>
                            <a asp-controller="RentalContract" asp-action="Details" asp-route-id="@invoice.ContractId"
                               class="btn btn-sm btn-outline-secondary">Hợp đồng</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const roomFilter = document.getElementById("roomFilter");
            const rows = Array.from(document.querySelectorAll("[data-invoice-row]"));
            const feedback = document.getElementById("paymentFeedback");
            const moneyFormatter = new Intl.NumberFormat("vi-VN", { maximumFractionDigits: 0 });

            const formatMoney = value => moneyFormatter.format(value) + " đ";

            function updateSummary() {
                const paidRows = rows.filter(row => row.dataset.paid === "true");
                const unpaidRows = rows.filter(row => row.dataset.paid !== "true");
                const sum = (items, key) => items.reduce((total, row) => total + Number(row.dataset[key] || 0), 0);

                document.getElementById("paidCount").textContent = paidRows.length;
                document.getElementById("unpaidCount").textContent = unpaidRows.length;
                document.getElementById("collectedAmount").textContent = formatMoney(sum(paidRows, "total"));
                document.getElementById("outstandingAmount").textContent = formatMoney(sum(unpaidRows, "total"));
                document.getElementById("electricityTotal").textContent = formatMoney(sum(rows, "electricity"));
                document.getElementById("waterTotal").textContent = formatMoney(sum(rows, "water"));
                document.getElementById("revenueTotal").textContent = formatMoney(sum(rows, "total"));
            }

            function showFeedback(message, success) {
                feedback.className = "alert " + (success ? "alert-success" : "alert-danger");
                feedback.textContent = message;
            }

            if (roomFilter) {
                roomFilter.addEventListener("change", () => {
                    const selectedRoom = roomFilter.value;
                    rows.forEach(row => {
                        row.hidden = selectedRoom !== "" && row.dataset.roomKey !== selectedRoom;
                    });
                });
            }

            document.querySelectorAll(".payment-status-form").forEach(form => {
                const checkbox = form.querySelector(".payment-status-checkbox");
                const label = form.querySelector(".payment-status-label");
                if (!checkbox) return;

                checkbox.addEventListener("change", async () => {
                    const previousValue = !checkbox.checked;
                    checkbox.disabled = true;

                    try {
                        const response = await fetch(form.action, {
                            method: "POST",
                            body: new FormData(form),
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });

                        let result;
                        try {
                            result = await response.json();
                        } catch {
                            throw new Error("Máy chủ không trả về phản hồi hợp lệ. Vui lòng thử lại.");
                        }

                        if (!response.ok || result.success !== true) {
                            throw new Error(result.message || "Không thể cập nhật trạng thái thu.");
                        }

                        const row = form.closest("[data-invoice-row]");
                        row.dataset.paid = result.isPaid ? "true" : "false";
                        label.textContent = result.isPaid ? "Đã thu" : "Chưa thu";
                        showFeedback(result.message, true);
                        updateSummary();
                    } catch (error) {
                        checkbox.checked = previousValue;
                        showFeedback(error.message || "Không thể cập nhật trạng thái thu.", false);
                    } finally {
                        checkbox.disabled = false;
                    }
                });
            });

            updateSummary();
        })();
    </script>
}