@model QuanLyNhaTro.Models.TenantProfile

@{
    ViewData["Title"] = "Sửa người thuê";
}

<h1>Sửa người thuê</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="TenantId" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Họ và tên</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label">Số điện thoại (không bắt buộc)</label>
        <input asp-for="Phone" type="tel" class="form-control" />
        <div class="form-text">Có thể để trống nếu người thuê chưa có số điện thoại riêng.</div>
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="IdentityNumber" class="form-label">Số CCCD/CMND</label>
        <input asp-for="IdentityNumber" class="form-control" />
        <span asp-validation-for="IdentityNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label">Ngày sinh đầy đủ (nếu biết)</label>
        <input asp-for="DateOfBirth" type="date" class="form-control" />
        <div class="form-text">Chỉ nhập khi biết chính xác ngày, tháng và năm sinh.</div>
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BirthYear" class="form-label">Năm sinh (nếu chỉ biết năm)</label>
        <input asp-for="BirthYear" type="number" class="form-control" />
        <div class="form-text">Nhập năm sinh nếu không biết đủ ngày/tháng. Không nhập đồng thời với ngày sinh đầy đủ.</div>
        <span asp-validation-for="BirthYear" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PermanentAddress" class="form-label">Địa chỉ thường trú</label>
        <textarea asp-for="PermanentAddress" class="form-control" rows="3"></textarea>
        <span asp-validation-for="PermanentAddress" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Ghi chú</label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

<div class="card mt-4 mb-3">
    <div class="card-header"><strong>Giấy tờ cá nhân</strong></div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            Chỉ chấp nhận ảnh JPG/JPEG hoặc PNG, tối đa 5 MB mỗi ảnh. Bạn có thể upload ảnh mới để thay thế ảnh hiện tại.
        </p>
        <div class="row g-3">
            <div class="col-lg-4">
                <div class="border rounded p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                        <strong>CCCD mặt trước</strong>
                        @if (!string.IsNullOrWhiteSpace(Model.IdentityCardFrontFileName))
                        {
                            <span class="badge text-bg-success">Đã tải lên</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Chưa có ảnh</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.IdentityCardFrontFileName))
                    {
                        <a asp-action="ViewDocument" asp-route-id="@Model.TenantId"
                           asp-route-documentType="IdentityCardFront" target="_blank" rel="noopener"
                           class="d-block text-center bg-light rounded p-2 mb-2">
                            <img src="@Url.Action("ViewDocument", new { id = Model.TenantId, documentType = "IdentityCardFront" })"
                                 alt="Ảnh CCCD mặt trước" class="img-fluid"
                                 style="max-height: 180px; width: 100%; object-fit: contain;" loading="lazy" />
                        </a>
                    }
                    <label for="identityCardFrontFile" class="form-label small">Chọn ảnh mặt trước</label>
                    <input id="identityCardFrontFile" class="form-control mb-2" type="file" name="identityCardFrontFile"
                               accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="border rounded p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                        <strong>CCCD mặt sau</strong>
                        @if (!string.IsNullOrWhiteSpace(Model.IdentityCardBackFileName))
                        {
                            <span class="badge text-bg-success">Đã tải lên</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Chưa có ảnh</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.IdentityCardBackFileName))
                    {
                        <a asp-action="ViewDocument" asp-route-id="@Model.TenantId"
                           asp-route-documentType="IdentityCardBack" target="_blank" rel="noopener"
                           class="d-block text-center bg-light rounded p-2 mb-2">
                            <img src="@Url.Action("ViewDocument", new { id = Model.TenantId, documentType = "IdentityCardBack" })"
                                 alt="Ảnh CCCD mặt sau" class="img-fluid"
                                 style="max-height: 180px; width: 100%; object-fit: contain;" loading="lazy" />
                        </a>
                    }
                    <label for="identityCardBackFile" class="form-label small">Chọn ảnh mặt sau</label>
                    <input id="identityCardBackFile" class="form-control mb-2" type="file" name="identityCardBackFile"
                               accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="border rounded p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                        <strong>Giấy khai sinh</strong>
                        @if (!string.IsNullOrWhiteSpace(Model.BirthCertificateFileName))
                        {
                            <span class="badge text-bg-success">Đã tải lên</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Chưa có ảnh</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.BirthCertificateFileName))
                    {
                        <a asp-action="ViewDocument" asp-route-id="@Model.TenantId"
                           asp-route-documentType="BirthCertificate" target="_blank" rel="noopener"
                           class="d-block text-center bg-light rounded p-2 mb-2">
                            <img src="@Url.Action("ViewDocument", new { id = Model.TenantId, documentType = "BirthCertificate" })"
                                 alt="Ảnh giấy khai sinh" class="img-fluid"
                                 style="max-height: 180px; width: 100%; object-fit: contain;" loading="lazy" />
                        </a>
                    }
                    <label for="birthCertificateFile" class="form-label small">Chọn ảnh giấy khai sinh</label>
                    <input id="birthCertificateFile" class="form-control mb-2" type="file" name="birthCertificateFile"
                               accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                </div>
            </div>
        </div>
    </div>
</div>

    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        if (window.jQuery && $.validator) {
            $.validator.messages.number =
                "Năm sinh phải là số nguyên hợp lệ.";
        }
    </script>
}