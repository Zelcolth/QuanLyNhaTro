@model QuanLyNhaTro.ViewModels.RentalContractFormViewModel

@{
    ViewData["Title"] = "Thêm hợp đồng thuê";
}

<h1>Thêm hợp đồng thuê</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    @if (ViewBag.OverlapWarning is string overlapWarning)
    {
        <div class="alert alert-warning" id="overlapWarning" role="alert">
            <p class="mb-2">@overlapWarning</p>
            <p class="mb-2">Để tiếp tục, xác nhận lưu bản nháp dù đang có xung đột lịch.</p>
            <button type="submit" name="confirmOverlap" value="true" id="confirmOverlapButton" class="btn btn-warning">Vẫn lưu bản nháp</button>
        </div>
    }

    <div class="mb-3">
        <label asp-for="ContractCode" class="form-label">Mã hợp đồng</label>
        <input asp-for="ContractCode" class="form-control" />
        <span asp-validation-for="ContractCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RoomId" class="form-label">Phòng</label>
        <select asp-for="RoomId" class="form-select" id="RoomId">
            <option value="">-- Chọn phòng --</option>
            @foreach (QuanLyNhaTro.ViewModels.RoomOptionViewModel roomOption in ViewBag.Rooms)
            {
                <option value="@roomOption.RoomId"
                        data-monthly-rent="@roomOption.MonthlyRent.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    @roomOption.DisplayName
                </option>
            }
        </select>
        <span asp-validation-for="RoomId" class="text-danger"></span>
    </div>

    @if (Model.TenantOptions.Count == 0)
    {
        <div class="alert alert-warning">
            Chưa có hồ sơ người thuê. Hãy <a asp-controller="Tenant" asp-action="Create">thêm người thuê</a> trước khi lập hợp đồng.
        </div>
    }
    else
    {
    <div class="mb-3">
        <label asp-for="PrimaryTenantId" class="form-label">Người đứng tên hợp đồng</label>
        <select asp-for="PrimaryTenantId" class="form-select">
            <option value="">-- Chọn người đứng tên --</option>
            @foreach (var tenant in Model.TenantOptions)
            {
                <option value="@tenant.TenantId">@tenant.FullName — @(string.IsNullOrWhiteSpace(tenant.Phone) ? "Chưa có SĐT" : tenant.Phone)</option>
            }
        </select>
        <span asp-validation-for="PrimaryTenantId" class="text-danger"></span>
        <div class="form-text">Khi lập hợp đồng chỉ chọn một người đứng tên. Người ở cùng sẽ được bổ sung sau khi kích hoạt hợp đồng.</div>
    </div>

    }

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDate" class="form-label">Ngày kết thúc</label>
            <input asp-for="EndDate" type="date" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Chỉ số điện nước khi bàn giao</h5>
            <p class="text-muted small">Ghi chỉ số công tơ tại ngày bắt đầu thuê để tính chính xác tiền điện, nước của tháng đầu tiên. Có thể lưu bản nháp trước, nhưng cần nhập đủ hai chỉ số để kích hoạt hợp đồng.</p>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MoveInElectricityReading" class="form-label">Chỉ số điện bàn giao (kWh)</label>
                    <input asp-for="MoveInElectricityReading" type="number" min="0" step="0.01" class="form-control" />
                    <span asp-validation-for="MoveInElectricityReading" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MoveInWaterReading" class="form-label">Chỉ số nước bàn giao (m³)</label>
                    <input asp-for="MoveInWaterReading" type="number" min="0" step="0.01" class="form-control" />
                    <span asp-validation-for="MoveInWaterReading" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="MonthlyRent" class="form-label">Giá thuê thỏa thuận (đồng/tháng)</label>
            <input asp-for="MonthlyRent" type="number" min="0.01" step="0.01" required class="form-control" />
            <span asp-validation-for="MonthlyRent" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Deposit" class="form-label">Tiền đặt cọc</label>
            <input asp-for="Deposit" type="number" min="0" step="0.01" class="form-control" />
            <span asp-validation-for="Deposit" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Terms" class="form-label">Điều khoản</label>
        <textarea asp-for="Terms" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Terms" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu bản nháp</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_OverlapWarningScripts" />
}
