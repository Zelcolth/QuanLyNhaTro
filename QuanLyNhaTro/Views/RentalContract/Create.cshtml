@model QuanLyNhaTro.Models.RentalContractFormViewModel

@{
    ViewData["Title"] = "Thêm hợp đồng thuê";
}

<h1>Thêm hợp đồng thuê</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="ContractCode" class="form-label">Mã hợp đồng</label>
        <input asp-for="ContractCode" class="form-control" />
        <span asp-validation-for="ContractCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RoomId" class="form-label">Phòng</label>
        <select asp-for="RoomId" asp-items="ViewBag.Rooms" class="form-select">
            <option value="">-- Chọn phòng --</option>
        </select>
        <span asp-validation-for="RoomId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Người thuê trong hợp đồng</label>
        <div class="form-text mb-2">Chọn một hoặc nhiều người thuê và chọn đúng một người đại diện. Quan hệ với người đại diện chỉ cần nhập cho những người còn lại.</div>
        @if (Model.TenantOptions.Count == 0)
        {
            <div class="alert alert-warning">
                Chưa có hồ sơ người thuê. Hãy <a asp-controller="Tenant" asp-action="Create">thêm người thuê</a> trước khi lập hợp đồng.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Chọn</th>
                            <th>Người thuê</th>
                            <th>Người đại diện</th>
                            <th>Quan hệ với người đại diện</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.TenantOptions.Count; i++)
                    {
                        <tr>
                            <td class="text-center">
                                <input type="hidden" asp-for="TenantOptions[i].TenantId" />
                                <input asp-for="TenantOptions[i].IsSelected" class="form-check-input" />
                            </td>
                            <td>
                                <div>@Model.TenantOptions[i].FullName</div>
                                <small class="text-muted">@Model.TenantOptions[i].Phone</small>
                            </td>
                            <td class="text-center">
                                <input asp-for="PrimaryTenantId" type="radio" value="@Model.TenantOptions[i].TenantId" id="PrimaryTenantId_@Model.TenantOptions[i].TenantId" class="form-check-input" />
                            </td>
                            <td>
                                <input asp-for="TenantOptions[i].RelationshipToPrimaryTenant" class="form-control" maxlength="100" placeholder="Ví dụ: vợ/chồng, con, bạn cùng thuê" />
                                <span asp-validation-for="TenantOptions[i].RelationshipToPrimaryTenant" class="text-danger"></span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <span asp-validation-for="TenantOptions" class="text-danger"></span>
        <span asp-validation-for="PrimaryTenantId" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDate" class="form-label">Ngày kết thúc</label>
            <input asp-for="EndDate" type="date" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="MonthlyRent" class="form-label">Giá thuê hàng tháng</label>
            <input asp-for="MonthlyRent" type="number" min="0" step="0.01" class="form-control" />
            <span asp-validation-for="MonthlyRent" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Deposit" class="form-label">Tiền đặt cọc</label>
            <input asp-for="Deposit" type="number" min="0" step="0.01" class="form-control" />
            <span asp-validation-for="Deposit" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label">Trạng thái</label>
        <select asp-for="Status" asp-items="ViewBag.Statuses" class="form-select"></select>
        <div class="form-text">Chỉ chọn Đang hiệu lực khi ngày hiện tại nằm trong thời hạn hợp đồng.</div>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Terms" class="form-label">Điều khoản</label>
        <textarea asp-for="Terms" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Terms" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
