@model QuanLyNhaTro.Models.Invoice

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    var isPaid = Model.Status == "Paid";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <h1>Chi tiết hóa đơn @Model.InvoiceCode</h1>
    <a asp-action="Index" asp-route-billingMonth="@Model.BillingMonth.ToString("yyyy-MM")"
       class="btn btn-outline-secondary">Quay lại danh sách</a>
</div>

<p class="mb-1"><strong>Kỳ hóa đơn:</strong> @Model.BillingMonth.ToString("MM/yyyy")</p>
<p class="mb-1"><strong>Ngày lập:</strong> @Model.IssuedAt.ToString("dd/MM/yyyy HH:mm")</p>
<p class="mb-1"><strong>Trạng thái thu:</strong> @(isPaid ? "Đã thu" : "Chưa thu")</p>
<p class="mb-1"><strong>Khu nhà / phòng:</strong> @Model.RoomLabelSnapshot</p>
<p class="mb-1"><strong>Người thuê:</strong> @Model.TenantNamesSnapshot</p>
<p class="mb-4"><strong>Mã hợp đồng:</strong> @Model.ContractCodeSnapshot</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Khoản thu</th>
                <th>Diễn giải</th>
                <th class="text-end">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Tiền thuê phòng</td>
                <td>Giá thuê theo hợp đồng</td>
                <td class="text-end">@Model.RentAmount.ToString("N0") VNĐ</td>
            </tr>
            <tr>
                <td>Tiền điện</td>
                <td>
                    Chỉ số: @Model.PreviousElectricityReading.ToString("N2") → @Model.CurrentElectricityReading.ToString("N2") kWh;
                    tiêu thụ @Model.ElectricityConsumption.ToString("N2") kWh × @Model.ElectricityUnitPrice.ToString("N0") VNĐ/kWh
                </td>
                <td class="text-end">@Model.ElectricityAmount.ToString("N0") VNĐ</td>
            </tr>
            <tr>
                <td>Tiền nước</td>
                <td>
                    Chỉ số: @Model.PreviousWaterReading.ToString("N2") → @Model.CurrentWaterReading.ToString("N2") m³;
                    tiêu thụ @Model.WaterConsumption.ToString("N2") m³ × @Model.WaterUnitPrice.ToString("N0") VNĐ/m³
                </td>
                <td class="text-end">@Model.WaterAmount.ToString("N0") VNĐ</td>
            </tr>
            <tr>
                <td>Phí rác</td>
                <td>Phụ phí theo cấu hình tại thời điểm lập hóa đơn</td>
                <td class="text-end">@Model.GarbageFee.ToString("N0") VNĐ</td>
            </tr>
            <tr>
                <td>Phí Internet</td>
                <td>Phụ phí theo cấu hình tại thời điểm lập hóa đơn</td>
                <td class="text-end">@Model.WifiFee.ToString("N0") VNĐ</td>
            </tr>
            <tr>
                <td>Nợ tháng trước</td>
                <td>Số dư chưa thanh toán được chuyển từ kỳ trước</td>
                <td class="text-end">@Model.PreviousDebtAmount.ToString("N0") VNĐ</td>
            </tr>
            <tr>
                <td>Tiền giảm trừ</td>
                <td>Khoản giảm được áp dụng cho hóa đơn này</td>
                <td class="text-end">-@Model.DiscountAmount.ToString("N0") VNĐ</td>
            </tr>
        </tbody>
        <tfoot class="table-light">
            <tr>
                <th colspan="2" class="text-end">Tổng cần thanh toán</th>
                <th class="text-end">@Model.TotalAmount.ToString("N0") VNĐ</th>
            </tr>
        </tfoot>
    </table>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="alert alert-secondary mt-3">
        <strong>Ghi chú:</strong> @Model.Notes
    </div>
}
