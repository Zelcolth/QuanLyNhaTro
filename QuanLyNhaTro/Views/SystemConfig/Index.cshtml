@model QuanLyNhaTro.ViewModels.SystemConfigViewModel

@{
    ViewData["Title"] = "Cấu hình hệ thống";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Cấu hình hệ thống</h1>
        <p class="text-muted mb-0">Thiết lập đơn giá và thông tin nhận tiền để sử dụng cho các nghiệp vụ tính hóa đơn sau này.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-controller="SystemConfig" asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <section class="mb-4">
                <h2 class="h5 mb-3">Đơn giá và phụ phí</h2>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="ElectricityPrice" class="form-label"></label>
                        <input asp-for="ElectricityPrice" class="form-control" type="number" min="0.01" step="0.01" />
                        <span asp-validation-for="ElectricityPrice" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="WaterPrice" class="form-label"></label>
                        <input asp-for="WaterPrice" class="form-control" type="number" min="0.01" step="0.01" />
                        <span asp-validation-for="WaterPrice" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="GarbageFee" class="form-label"></label>
                        <input asp-for="GarbageFee" class="form-control" type="number" min="0" step="0.01" />
                        <span asp-validation-for="GarbageFee" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="WifiFee" class="form-label"></label>
                        <input asp-for="WifiFee" class="form-control" type="number" min="0" step="0.01" />
                        <span asp-validation-for="WifiFee" class="text-danger small"></span>
                    </div>
                </div>
                <p class="form-text mb-0 mt-2">Các mức phí này cần được xác nhận theo cách tính thực tế của khu trọ trước khi lập hóa đơn.</p>
            </section>

            <hr class="my-4" />

            <section class="mb-4">
                <h2 class="h5 mb-3">Thông tin nhận thanh toán VietQR</h2>
                <p class="text-muted small">Có thể để trống phần này trong giai đoạn đầu. Nếu nhập thông tin nhận tiền, cần điền đủ cả ba trường.</p>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="BankCode" class="form-label"></label>
                        <input asp-for="BankCode" class="form-control" autocomplete="off" />
                        <span asp-validation-for="BankCode" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="BankAccount" class="form-label"></label>
                        <input asp-for="BankAccount" class="form-control" inputmode="numeric" autocomplete="off" />
                        <span asp-validation-for="BankAccount" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="AccountName" class="form-label"></label>
                        <input asp-for="AccountName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="AccountName" class="text-danger small"></span>
                    </div>
                </div>
            </section>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Lưu cấu hình</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
