@model QuanLyNhaTro.ViewModels.TenantIdentityCardPrintViewModel

@{
    Layout = null;
    ViewData["Title"] = Model.Title;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Title</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 20px;
            color: #212529;
            background: #f5f5f5;
            font-family: Arial, sans-serif;
        }
        .toolbar, .notice-area {
            max-width: 190mm;
            margin: 0 auto 16px;
        }
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }
        .toolbar h1 { margin: 0; font-size: 20px; }
        .toolbar-actions { display: flex; gap: 8px; }
        .button {
            display: inline-block;
            padding: 8px 14px;
            border: 1px solid #6c757d;
            border-radius: 4px;
            color: #212529;
            background: #fff;
            text-decoration: none;
            font: inherit;
            cursor: pointer;
        }
        .button-primary {
            color: #fff;
            border-color: #0d6efd;
            background: #0d6efd;
        }
        .notice {
            padding: 12px 14px;
            margin-bottom: 10px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            background: #fff;
        }
        .notice-warning {
            border-color: #e0b04b;
            background: #fff8e5;
        }
        .notice ul { margin: 8px 0 0; padding-left: 22px; }
        .print-content {
            max-width: 190mm;
            margin: 0 auto;
            padding: 12mm;
            background: #fff;
        }
        .identity-card-pair {
            margin-bottom: 12mm;
            break-inside: avoid;
            page-break-inside: avoid;
        }
        .tenant-heading {
            margin: 0 0 5mm;
            font-size: 12pt;
            font-weight: 700;
        }
        .tenant-room {
            display: block;
            margin-top: 1mm;
            color: #555;
            font-size: 9pt;
            font-weight: 400;
        }
        .identity-card-sides {
            display: flex;
            align-items: flex-start;
            gap: 5mm;
        }
        .identity-card-side {
            flex: 0 0 85.6mm;
            width: 85.6mm;
        }
        .side-label {
            margin-bottom: 1.5mm;
            font-size: 8pt;
            color: #444;
        }
        .identity-card-image {
            display: block;
            width: 85.6mm;
            height: 54mm;
            border: 0.2mm solid #999;
            object-fit: contain;
            background: #fff;
        }
        .empty-state {
            max-width: 190mm;
            margin: 0 auto;
            padding: 20px;
            border: 1px solid #ced4da;
            background: #fff;
        }
        @page {
            size: A4 portrait;
            margin: 10mm;
        }
        @media print {
            body { padding: 0; background: #fff; }
            .no-print { display: none !important; }
            .print-content {
                max-width: none;
                margin: 0;
                padding: 0;
            }
            .identity-card-pair {
                margin-bottom: 10mm;
                break-inside: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="toolbar no-print">
        <div>
            <h1>@Model.Title</h1>
            <div>@Model.TotalTenants người · @Model.PrintableTenants.Count người đủ hai mặt CCCD</div>
        </div>
        <div class="toolbar-actions">
            @if (Model.PrintableTenants.Count > 0)
            {
                <button type="button" class="button button-primary" onclick="window.print()">In CCCD</button>
            }
            <button type="button" class="button" onclick="window.close()">Đóng</button>
        </div>
    </div>

    @if (Model.IncompleteTenants.Count > 0)
    {
        <div class="notice notice-warning notice-area no-print">
            <strong>Không in được @Model.IncompleteTenants.Count người do thiếu ảnh CCCD:</strong>
            <ul>
                @foreach (var tenant in Model.IncompleteTenants)
                {
                    <li>
                        @tenant.FullName
                        @if (!string.IsNullOrWhiteSpace(tenant.RoomLabel))
                        {
                            <span> — @tenant.RoomLabel</span>
                        }
                        — Thiếu @tenant.MissingDocuments
                    </li>
                }
            </ul>
        </div>
    }

    @if (Model.PrintableTenants.Count == 0)
    {
        <div class="empty-state">
            @if (Model.TotalTenants == 0)
            {
                <strong>Không có người đang ở trong phạm vi được chọn.</strong>
            }
            else
            {
                <strong>Không có người nào đủ ảnh hai mặt CCCD để in.</strong>
            }
            <p style="margin-bottom: 0;">Vui lòng bổ sung ảnh còn thiếu trong trang Chi tiết khách thuê.</p>
        </div>
    }
    else
    {
        <main class="print-content">
            @foreach (var tenant in Model.PrintableTenants)
            {
                <section class="identity-card-pair">
                    <h2 class="tenant-heading">
                        @tenant.FullName
                        @if (!string.IsNullOrWhiteSpace(tenant.RoomLabel))
                        {
                            <span class="tenant-room">@tenant.RoomLabel</span>
                        }
                    </h2>
                    <div class="identity-card-sides">
                        <div class="identity-card-side">
                            <div class="side-label">Mặt trước</div>
                            <img class="identity-card-image"
                                 src="@Url.Action("ViewDocument", "Tenant", new { id = tenant.TenantId, documentType = "IdentityCardFront" })"
                                 alt="CCCD mặt trước - @tenant.FullName" />
                        </div>
                        <div class="identity-card-side">
                            <div class="side-label">Mặt sau</div>
                            <img class="identity-card-image"
                                 src="@Url.Action("ViewDocument", "Tenant", new { id = tenant.TenantId, documentType = "IdentityCardBack" })"
                                 alt="CCCD mặt sau - @tenant.FullName" />
                        </div>
                    </div>
                </section>
            }
        </main>
    }

    <script>
        window.addEventListener("load", function () {
            if (document.querySelector(".identity-card-pair")) {
                window.setTimeout(function () { window.print(); }, 300);
            }
        });
    </script>
</body>
</html>
