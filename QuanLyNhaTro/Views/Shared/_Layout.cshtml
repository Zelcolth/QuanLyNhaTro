<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Website quản lý khu nhà, phòng, người thuê và hợp đồng thuê." />
    <title>@ViewData["Title"] - Quản lý nhà trọ</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyNhaTro.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    @{ var currentController = ViewContext.RouteData.Values["controller"]?.ToString(); }
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-semibold text-primary" asp-controller="Room" asp-action="Index">
                    <span class="badge text-bg-primary me-2">NT</span>Quản lý nhà trọ
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Mở hoặc đóng menu điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Room" ? "active fw-semibold" : "")"
                               aria-current="@(currentController == "Room" ? "page" : null)"
                               asp-controller="Room" asp-action="Index">Phòng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Building" ? "active fw-semibold" : "")"
                               aria-current="@(currentController == "Building" ? "page" : null)"
                               asp-controller="Building" asp-action="Index">Khu nhà</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Tenant" ? "active fw-semibold" : "")"
                               aria-current="@(currentController == "Tenant" ? "page" : null)"
                               asp-controller="Tenant" asp-action="Index">Người thuê</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "RentalContract" ? "active fw-semibold" : "")"
                               aria-current="@(currentController == "RentalContract" ? "page" : null)"
                               asp-controller="RentalContract" asp-action="Index">Hợp đồng</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-auto border-top bg-white text-muted py-3">
        <div class="container small">
            Website quản lý nhà trọ
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
