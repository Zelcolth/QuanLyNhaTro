@model QuanLyNhaTro.Models.TenantProfile

@{
    ViewData["Title"] = "Xóa người thuê";
}

<h1>Xóa người thuê</h1>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="alert alert-warning" role="alert">
    Bạn có chắc muốn xóa người thuê này không? Không thể xóa người thuê nếu còn hợp đồng thuê tham chiếu.
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Họ và tên</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4">Số điện thoại</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa có" : Model.Phone)</dd>


            <dt class="col-sm-4">Thông tin ngày sinh</dt>
            @if (Model.DateOfBirth.HasValue)
            {
                <dd class="col-sm-8">@Model.DateOfBirth.Value.ToString("dd/MM/yyyy")</dd>
            }
            else if (Model.BirthYear.HasValue)
            {
                <dd class="col-sm-8">Năm sinh: @Model.BirthYear.Value — chưa có ngày/tháng sinh đầy đủ</dd>
            }
            else
            {
                <dd class="col-sm-8">Chưa xác minh được thông tin ngày sinh</dd>
            }
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="TenantId" />
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
