@model IEnumerable<QuanLyNhaTro.Models.TenantProfile>

@{
    ViewData["Title"] = "Quản lý người thuê";
    var linkedTenantIds = ViewBag.LinkedTenantIds as HashSet<int> ?? new HashSet<int>();
    var currentlyRentingTenantIds = ViewBag.CurrentlyRentingTenantIds as HashSet<int> ?? new HashSet<int>();
    var formerTenantIds = ViewBag.FormerTenantIds as HashSet<int> ?? new HashSet<int>();
    var exportBuildings = ViewBag.ExportBuildings as List<QuanLyNhaTro.Models.Building> ?? new List<QuanLyNhaTro.Models.Building>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý người thuê</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm người thuê</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="small text-secondary mb-1">Tổng số người thuê</div>
                <div class="fs-3 fw-semibold">@ViewBag.TotalTenants</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="small text-secondary mb-1">Đang thuê hiện tại</div>
                <div class="fs-3 fw-semibold">@ViewBag.CurrentlyRentingTenants</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="small text-secondary mb-1">Đã từng thuê / chưa thuê</div>
                <div class="fs-3 fw-semibold">@ViewBag.FormerTenants</div>
            </div>
        </div>
    </div>
</div>


<div class="card mb-3">
    <div class="card-header"><strong>Xuất Excel thông tin người thuê</strong></div>
    <div class="card-body">
        <form asp-action="ExportExcel" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="tenantExportStatus" class="form-label">Danh sách cần xuất</label>
                <select id="tenantExportStatus" name="tenantStatus" class="form-select">
                    <option value="current">Người đang thuê</option>
                    <option value="former">Người từng thuê</option>
                    <option value="all" selected>Tất cả người đã thuê</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="tenantExportBuilding" class="form-label">Dãy / Khu nhà</label>
                <select id="tenantExportBuilding" name="buildingId" class="form-select">
                    <option value="">Tất cả dãy / khu nhà</option>
                    @foreach (var building in exportBuildings)
                    {
                        <option value="@building.BuildingId">@building.BuildingName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-outline-success">Xuất Excel</button>
            </div>
        </form>
        <div class="form-text mt-2">
            Mỗi dòng tương ứng một lượt thuê. Người thuê nhiều lần sẽ có nhiều dòng để giữ nguyên lịch sử.
            Hồ sơ chưa từng có hợp đồng thuê không nằm trong file.
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có người thuê nào.</div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Họ và tên</th>
                    <th>Số điện thoại</th>
                    <th>Ngày sinh / Năm sinh</th>
                    <th>Số CCCD/CMND</th>
                    <th>Quá trình thuê</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var tenant in Model)
            {
                <tr>
                    <td>@tenant.FullName</td>
                    <td>@(string.IsNullOrWhiteSpace(tenant.Phone) ? "Chưa có" : tenant.Phone)</td>
                    <td>@(tenant.DateOfBirth?.ToString("dd/MM/yyyy") ?? (tenant.BirthYear.HasValue ? $"Năm {tenant.BirthYear.Value}" : "Chưa xác minh"))</td>
                    <td>@(tenant.IdentityNumber ?? "Chưa có")</td>
                    <td>
                        @if (currentlyRentingTenantIds.Contains(tenant.TenantId))
                        {
                            <span class="badge text-bg-success text-dark">Đang cư trú</span>
                        }
                        else if (formerTenantIds.Contains(tenant.TenantId))
                        {
                            <span class="badge text-bg-secondary text-dark">Đã từng thuê</span>
                        }
                        else
                        {
                            <span class="badge text-bg-light text-dark">Chưa có lịch sử thuê</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@tenant.TenantId" class="btn btn-sm btn-outline-info">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@tenant.TenantId" class="btn btn-sm btn-outline-primary">Sửa</a>
                        @if (!linkedTenantIds.Contains(tenant.TenantId))
                        {
                            <a asp-action="Delete" asp-route-id="@tenant.TenantId" class="btn btn-sm btn-outline-danger">Xóa</a>
                        }
                        else
                        {
                            <span class="small text-dark">Đã lưu hồ sơ</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
}
