@model QuanLyNhaTro.ViewModels.RoomDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết phòng";
    var room = Model.Room;
    var contract = Model.ActiveContract;
    var statusText = room.Status switch
    {
        "Available" => "Trống",
        "Occupied" => "Đang thuê",
        "Maintenance" => "Bảo trì",
        "Cleaning" => "Chờ xử lý",
        _ => room.Status
    };
    var primaryTenant = contract?.ContractTenants.FirstOrDefault(item => item.IsPrimaryTenant);
}

<h1>Chi tiết phòng</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="card mb-3">
    <div class="card-header"><strong>Thông tin phòng</strong></div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Tòa nhà</dt>
            <dd class="col-sm-8">@room.Building.BuildingName</dd>

            <dt class="col-sm-4">Mã phòng</dt>
            <dd class="col-sm-8">@room.RoomCode</dd>

            <dt class="col-sm-4">Giá thuê niêm yết hàng tháng</dt>
            <dd class="col-sm-8">@room.MonthlyRent.ToString("N0")</dd>

            <dt class="col-sm-4">Số người tối đa</dt>
            <dd class="col-sm-8">@room.MaxOccupants</dd>

            <dt class="col-sm-4">Trạng thái</dt>
            <dd class="col-sm-8">@statusText</dd>

            <dt class="col-sm-4">Mô tả</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(room.Description) ? "Chưa có" : room.Description)</dd>
        </dl>
    </div>
</div>

@if (contract is not null)
{
    <div class="card mb-3">
        <div class="card-header"><strong>Thông tin thuê hiện tại</strong></div>
        <div class="card-body">
            <dl class="row mb-3">
                <dt class="col-sm-4">Mã hợp đồng</dt>
                <dd class="col-sm-8">@contract.ContractCode</dd>

                <dt class="col-sm-4">Người đứng tên</dt>
                <dd class="col-sm-8">@(primaryTenant?.Tenant.FullName ?? "Chưa có")</dd>

                <dt class="col-sm-4">Ngày bắt đầu</dt>
                <dd class="col-sm-8">@contract.StartDate.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-4">Ngày kết thúc hợp đồng</dt>
                <dd class="col-sm-8">@contract.EndDate.ToString("dd/MM/yyyy")</dd>
            </dl>

            <hr />

            <h2 class="h5 mb-3">Thông tin hẹn trả phòng</h2>
            @if (contract.ExpectedMoveOutDate.HasValue)
            {
                <p class="mb-2">
                    <span class="badge text-bg-warning text-dark">Khách hẹn trả phòng</span>
                    <span class="ms-1">Dự kiến @contract.ExpectedMoveOutDate.Value.ToString("dd/MM/yyyy")</span>
                </p>
            }
            else
            {
                <p class="text-muted">Chưa ghi nhận ngày khách dự kiến trả phòng.</p>
            }

            <form asp-controller="RentalContract" asp-action="SetMoveOutDate"
                  asp-route-id="@contract.ContractId" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-5">
                    <label for="expectedMoveOutDate" class="form-label">Ngày khách dự kiến trả phòng</label>
                    <input type="date" name="expectedMoveOutDate" id="expectedMoveOutDate"
                           class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           max="@contract.EndDate.ToString("yyyy-MM-dd")"
                           value="@(contract.ExpectedMoveOutDate?.ToString("yyyy-MM-dd") ?? string.Empty)" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-outline-primary">
                        @(contract.ExpectedMoveOutDate.HasValue ? "Cập nhật ngày hẹn" : "Lưu ngày hẹn")
                    </button>
                </div>
                <div class="col-12 small text-muted">Để trống ngày và lưu để xóa thông tin hẹn trả phòng.</div>
            </form>

            <div class="mt-3">
                <a asp-controller="RentalContract" asp-action="Details" asp-route-id="@contract.ContractId"
                   class="btn btn-sm btn-outline-secondary">Xem chi tiết hợp đồng</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body text-muted">
            Phòng hiện không có hợp đồng đang hiệu lực nên chưa thể ghi nhận ngày hẹn trả phòng.
        </div>
    </div>
}

<div>
    <a asp-action="Edit" asp-route-id="@room.RoomId" class="btn btn-primary">Sửa phòng</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>
